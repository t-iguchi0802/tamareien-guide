---
/**
 * 多磨霊園周辺の石材店一覧・比較。
 * 2026-10-03: スマホ優先で6つの短い条件チェック＋コンパクトな石材店カードへ再設計。
 * 詳細な12サービス比較表は折りたたみ内に残し、必要な人だけが開ける。
 */
import '../../styles/guide-article.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../lib/routes';
import { getBusinesses, getActiveSponsors } from '../../lib/data';
import ComparisonTable from '../../components/business/ComparisonTable.astro';
import ServiceFilter from '../../components/business/ServiceFilter.astro';
import BusinessGrid from '../../components/business/BusinessGrid.astro';
import CorrectionCta from '../../components/common/CorrectionCta.astro';
import { ALL_SERVICE_KEYS } from '../_lib/business-display';
import { buildBusinessListItemListJsonLd } from '../../lib/seo';

const businesses = getBusinesses();
const sponsoredBusinessIds = getActiveSponsors()
  .map((sponsor) => sponsor.linkedBusinessId)
  .filter((id): id is string => id !== null);

const pageTitle = '多磨霊園の石材店・石屋を比較｜墓石・リフォーム・墓じまい';
const heroHeading = '多磨霊園の石材店一覧・比較';
const description = `多磨霊園周辺の石材店・石屋${businesses.length}社を、墓石の建立・リフォーム・修理、墓じまい、清掃・管理などの目的から比較できます。公開情報のみで中立に整理しています。`;

const businessListJsonLd = buildBusinessListItemListJsonLd(
  businesses.map((business) => ({
    business,
    path: `${ROUTES.sekizaiten.path}#business-${business.id}`,
  })),
  { listPath: ROUTES.sekizaiten.path, name: heroHeading, description },
);
---

<BaseLayout title={pageTitle} description={description} extraJsonLd={[businessListJsonLd]}>
  <Fragment slot="beforeSponsor">
    <h1>{heroHeading}</h1>
    <p class="page-lead">
      6つの項目から選ぶと、対応を確認できた石材店だけに絞り込めます。
    </p>

    <ServiceFilter
      businesses={businesses}
      mode="inline"
      externalGrid
      externalResult
      sponsoredBusinessIds={sponsoredBusinessIds}
    />
  </Fragment>

  <div class="stone-list-summary">
    <p class="stone-list-summary__label">石材店一覧</p>
    <p class="stone-list-summary__count" aria-live="polite">
      <span data-result-prefix>掲載石材店</span>
      <strong data-result-count>{businesses.length}</strong>社
    </p>
    <button type="button" class="stone-list-summary__clear" data-filter-clear hidden>
      選択をクリア
    </button>
  </div>

  <section aria-label="石材店一覧・詳しい比較表">
    <BusinessGrid businesses={businesses} sponsoredBusinessIds={sponsoredBusinessIds} />

    <hr class="masonry-rule" />

    <details class="detail-table">
      <summary class="detail-table__summary">全31社・全12サービスの詳しい比較表を見る</summary>
      <p class="detail-table__note">
        一覧カードでは見やすさを優先して表示を簡潔にしています。ここでは12サービスすべての公開確認状況を比較できます。
        「○ 公開確認済み」以外は非対応という意味ではなく、公開ページ上で確認できなかったことを示します。
      </p>
      <ComparisonTable businesses={businesses} visibleServices={ALL_SERVICE_KEYS} />
    </details>
  </section>

  <CorrectionCta />

  <section aria-labelledby="links-heading">
    <h2 id="links-heading">関連ページ</h2>
    <ul class="article__related-grid">
      <li><a class="article__related-card" href={ROUTES.hakajimai.path}>墓じまい・墓石撤去の比較を見る</a></li>
      <li><a class="article__related-card" href={ROUTES.kanri.path}>墓所管理・清掃・供花の比較を見る</a></li>
      <li><a class="article__related-card" href={ROUTES.tetsuzuki.path}>改葬・墓所返還などの手続きを見る</a></li>
      <li>
        <a
          class="article__related-card"
          href={ROUTES.guideProcedures.path}
          data-event="internal_guide_link_click"
          data-destination="guide_procedures"
        >墓じまい・お墓の手続き 総合案内を見る</a>
      </li>
      <li><a class="article__related-card" href={ROUTES.sources.path}>情報源・最終確認日を見る</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .stone-list-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0 0 var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-stone-line);
    border-radius: var(--radius-card);
    background: var(--color-stone-surface);
  }

  .stone-list-summary__label {
    width: 100%;
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-text);
  }

  .stone-list-summary__count {
    margin: 0;
    font-size: 0.96rem;
  }

  .stone-list-summary__count strong {
    margin-inline: 0.25em;
    font-family: var(--font-family-heading);
    font-size: 1.25rem;
    color: var(--color-accent-deep);
  }

  .stone-list-summary__clear {
    min-height: var(--tap-target-min);
    padding: 0.3em 0.4em;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    text-decoration: underline;
    font: inherit;
    cursor: pointer;
  }

  .stone-list-summary__clear[hidden] {
    display: none;
  }

  .masonry-rule {
    margin-block: var(--space-6);
  }

  .page-lead {
    margin: 0 0 var(--space-4);
    color: var(--color-stone-text);
    font-size: 1rem;
  }

  .detail-table {
    margin-bottom: var(--space-6);
  }

  .detail-table__summary {
    cursor: pointer;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1.05rem;
    min-height: var(--tap-target-min);
    display: flex;
    align-items: center;
    padding: var(--space-2) 0;
  }

  .detail-table__note {
    color: var(--color-stone-text);
    font-size: var(--font-size-label, 0.9375rem);
  }

  @media (max-width: 767px) {
    .stone-list-summary {
      margin-top: var(--space-2);
      margin-bottom: var(--space-3);
      padding: 0.7rem 0.9rem;
    }

    .stone-list-summary__label {
      font-size: 0.9rem;
    }

    .stone-list-summary__count {
      width: 100%;
      font-size: 0.88rem;
    }

    .stone-list-summary__count strong {
      font-size: 1.15rem;
    }

    .page-lead {
      margin-bottom: var(--space-2);
      font-size: 0.9rem;
      line-height: 1.45;
    }
  }
</style>
