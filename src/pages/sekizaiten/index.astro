---
/**
 * 14社の一覧・比較表。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章 / src/lib/routes.ts ROUTES.sekizaiten
 *
 * editorial-redesign（2026-08-26）: 「目的から探す」体験の本体をこのページに置く。
 * 共有コンポーネント <ServiceFilter mode="inline"> が、3つの目的ボタン・
 * くわしい条件チェックボックス・対応件数・事業者カードグリッドを
 * まとめて描画する（絞り込みロジックはServiceFilter側に一本化）。
 * TOPページの「この条件で一覧を見る」から遷移した場合、
 * ?services=a,b,c を読み取って同じ選択状態を復元する
 * （ServiceFilter内のスクリプトが担当）。
 *
 * 全12サービスの詳細な比較表（<ComparisonTable>）は、SaaS管理画面的な
 * 密な表を主役にしないよう<details>で折りたたみ、必要な人だけが開く
 * 「詳しい比較表」として維持する（機能・データは変更していない）。
 *
 * スポンサー条件付き上位表示（2026-08-27追加）: スポンサー契約中の事業者
 * （sponsors.jsonのlinkedBusinessIdがbusinesses.jsonのidと一致するもの）
 * のidをここで計算し、ServiceFilterへ渡す。実際の並べ替え・バッジ表示は
 * ServiceFilter.astro側で行う（判定ロジックの置き場所を1箇所にする）。
 * sponsors.json/businesses.jsonの内容自体はここでも変更しない。
 *
 * モバイル最優先レビュー対応（2026-09-01）: ページ上部に小さめの写真
 * （hero-cemetery-photo-v2.png、既存プロジェクト内画像を別クロップで再利用。
 * 新規取得はしていない）を追加し、「石材店を比較している」ことが一目で
 * 伝わるようにした。ServiceFilterより前に置くと絞り込みUIが初期画面から
 * さらに押し出されるため、低め高さ（article__hero-photo--compact、
 * guide-article.cssから再利用）に抑えている。「関連ページ」もカード化した。
 * ServiceFilter・ComparisonTable・絞り込みロジックは変更していない。
 *
 * スポンサー枠の位置とモバイル圧縮（2026-09-01、ミチのモバイル優先UI・
 * 文章校正対応「スマートフォンのスポンサー枠」節）: 従来はページ末尾
 * （比較表・関連ページの後）にあったスポンサー枠を、「結果件数の後、
 * 事業者一覧の前」へ移動した。BaseLayout.astroの`beforeSponsor`スロット
 * （TOPページと同じ仕組み）を使い、`<ServiceFilter externalGrid>`で
 * グリッド自体はServiceFilterに描画させず、このページ側で
 * `<BusinessGrid>`として「後半」に描画する（フィルタリングJSは
 * document.querySelectorで探すよう変更済み、判定ロジックは無変更。
 * 詳細はServiceFilter.astro・BusinessGrid.astroのコメント参照）。
 * PCの左右2枠ずつのレイアウトは変更していない。
 */
import '../../styles/guide-article.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../lib/routes';
import { getBusinesses, getActiveSponsors } from '../../lib/data';
import ComparisonTable from '../../components/business/ComparisonTable.astro';
import ServiceFilter from '../../components/business/ServiceFilter.astro';
import BusinessGrid from '../../components/business/BusinessGrid.astro';
import CorrectionCta from '../../components/common/CorrectionCta.astro';
import { ALL_SERVICE_KEYS } from '../_lib/business-display';
import { buildBusinessListItemListJsonLd } from '../../lib/seo';

const businesses = getBusinesses();
const sponsoredBusinessIds = getActiveSponsors()
  .map((sponsor) => sponsor.linkedBusinessId)
  .filter((id): id is string => id !== null);
/*
 * title/description/H1の更新（2026-09-02、ミチの編集改善・SEO/AIO対応
 * 「title・description・H1」節）: BaseLayoutのタイトル自動サフィックスを
 * 廃止したため、ページごとに完結した<title>文字列を用意する。H1は
 * ブラウザタブのタイトルとは別に、画面表示用の短い見出し（heroHeading）
 * として分ける（複合タイトルの「｜」がモバイル幅でH1として折り返される
 * ことを避けるため）。
 */
// title更新（2026-09-02、ナビゲーション・運営者表示・SEO/AIO監査対応
// 「ページタイトルと検索意図」節）: 「条件で探す」という実際の操作
// （絞り込みチェックボックス）をより直接的に表す文言へ変更した。
const pageTitle = '多磨霊園周辺の石材店を条件で探す｜多磨霊園 お墓ガイド';
const heroHeading = '多磨霊園の石材店一覧・比較';
const description =
  '多磨霊園周辺の石材店・お墓関連事業者14社を、墓石を建てる・直す、墓じまい、清掃・管理などの目的から比較できます。公開情報のみで中立に整理しています。';

/*
 * ItemList構造化データ（2026-09-02、ミチの編集改善・SEO/AIO対応
 * 「構造化データ」節）: 14社の一覧であることを構造化データでも示す。
 * itemListOrderをUnorderedにするbuildItemListJsonLd側の実装により、
 * 「推奨順位のランキングではない」ことを明示している（displayOrderは
 * あくまで管理用の安定表示順。data_dictionary.md・CLAUDE.md参照）。
 * 各itemのURLは、個別事業者ページを作らない方針（CLAUDE.md「薄い個別
 * ページを量産しない」）のため、本ページ内の該当カードへのアンカー
 * （#business-{id}、BusinessCard.astroのid属性）を使う。
 */
const businessListJsonLd = buildBusinessListItemListJsonLd(
  businesses.map((business) => ({ business, path: `${ROUTES.sekizaiten.path}#business-${business.id}` })),
  { listPath: ROUTES.sekizaiten.path, name: heroHeading, description },
);
---

<BaseLayout title={pageTitle} description={description} extraJsonLd={[businessListJsonLd]}>
  <Fragment slot="beforeSponsor">
    <h1>{heroHeading}</h1>
    <div
      class="article__hero-photo article__hero-photo--compact"
      style="background-image:url('/images/hero-cemetery-photo-v2.png');background-position:center 55%;"
    ></div>
    <p class="article__hero-photo__credit">イメージ写真</p>
    <p>
      掲載情報は、各社のWebサイト等で確認できた公開情報をもとに整理しています。事業者への確認で得た情報は、確認後に随時反映します。掲載順は事業者の推奨順位ではありません。詳しくは<a
        href={ROUTES.about.path}>運営方針・掲載基準</a
      >をご覧ください。
    </p>

    <ServiceFilter
      businesses={businesses}
      mode="inline"
      sponsoredBusinessIds={sponsoredBusinessIds}
      externalGrid
    />
  </Fragment>

  <section aria-label="事業者一覧・詳しい比較表">
    <BusinessGrid businesses={businesses} />

    <hr class="masonry-rule" />

    <details class="detail-table">
      <summary class="detail-table__summary">全事業者・全12サービスの詳しい比較表を見る</summary>
      <p class="detail-table__note">
        上のカードで表示しきれない、すべてのサービスの対応状況を1つの表にまとめたものです。「○
        公開確認済み」以外は対応がないという意味ではなく、公開ページ上で確認できなかったことを示します。
      </p>
      <ComparisonTable businesses={businesses} visibleServices={ALL_SERVICE_KEYS} />
    </details>
  </section>

  <CorrectionCta />

  <section aria-labelledby="links-heading">
    <h2 id="links-heading">関連ページ</h2>
    <ul class="article__related-grid">
      <li><a class="article__related-card" href={ROUTES.hakajimai.path}>墓じまい・墓石撤去の比較を見る</a></li>
      <li><a class="article__related-card" href={ROUTES.kanri.path}>墓所管理・清掃・供花の比較を見る</a></li>
      <li><a class="article__related-card" href={ROUTES.tetsuzuki.path}>改葬・墓所返還などの手続きを見る</a></li>
      <li><a class="article__related-card" href={ROUTES.guideProcedures.path} data-event="internal_guide_link_click" data-destination="guide_procedures">墓じまい・お墓の手続き 総合案内を見る</a></li>
      <li><a class="article__related-card" href={ROUTES.sources.path}>情報源・最終確認日を見る</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .masonry-rule {
    margin-block: var(--space-6);
  }

  .detail-table {
    margin-bottom: var(--space-6);
  }

  .detail-table__summary {
    cursor: pointer;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1.1rem;
    min-height: var(--tap-target-min);
    display: flex;
    align-items: center;
    padding: var(--space-2) 0;
  }

  .detail-table__note {
    color: var(--color-stone-text);
    font-size: var(--font-size-label, 0.9375rem);
  }
</style>
