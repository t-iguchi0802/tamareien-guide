---
/**
 * 運営方針、掲載基準、広告方針、訂正窓口。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章・6章 / src/lib/routes.ts ROUTES.about
 *
 * editorialPolicy（businesses.json）を根拠として方針を説明する。
 *
 * スポンサー掲載・訂正窓口の文章刷新とmailto化（2026-09-02、「スポンサー
 * 掲載ページと訂正窓口の文章」対応）: siteConfig.contact.contactEmailが
 * 確定したため、「準備中」表示をやめ、実際のメールアドレスへのmailto
 * リンクへ置き換えた。あわせて、未完成・言い訳に見える文章
 * （「当サイトの計測の仕組み上、集計できる設計にしています」
 * 「現時点で集計値そのものを外部提供する運用は開始していません」
 * 「下記の訂正窓口と同じ連絡先までお問い合わせください」等）を削除し、
 * 指定の簡潔な文章へ差し替えた。スポンサー掲載・訂正依頼は同じ
 * メールアドレスを使うが、mailtoのsubject/bodyを用途ごとに変えて区別する
 * （件名・本文の入力項目はGA4へは送信しない。GA4が送信するのは
 * ボタンのクリックそのもの＝`sponsor_inquiry_click`/
 * `correction_request_click`のpage_pathのみ）。
 *
 * 運営者情報の記載方針変更（2026-08-27、サイト所有者判断）: 従来ここに
 * 表示していた非公式表記の定型文（siteConfig.officialDisclaimer）は
 * 削除した。CLAUDE.md 2章の改定により、誤認防止は「常時表示の注意書き」
 * ではなく、専用ページ（このページ）での運営者情報の明示によって担保する
 * 方針になったため、見出しを「非公式表記」から「運営者について」へ変更し、
 * 運営者が東京都・多磨霊園・東京都公園協会のいずれとも異なる独立した
 * 民間の運営者であることを、この段落でのみ説明する（他ページへは
 * 繰り返し表示しない）。
 *
 * スポンサー枠の位置（2026-09-01、ミチのモバイル優先UI・文章校正対応
 * 「スマートフォンのスポンサー枠」節）: 「最初の主要説明の後」にスポンサー
 * 枠を置く指示のため、h1と「運営者について」セクションをBaseLayout.astroの
 * `beforeSponsor`スロット（TOPページと同じ仕組み）へ渡し、「掲載基準」以降を
 * 既定スロットへ渡した。PCの左右レール・見出し・本文・訂正窓口の内容は
 * 変更していない。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../lib/siteConfig';
import { ROUTES } from '../../lib/routes';
import { getBusinessDataset } from '../../lib/data';

const dataset = getBusinessDataset();
const { editorialPolicy } = dataset;

const pageTitle = '運営方針・掲載基準・広告方針・訂正窓口';
const description =
  '当サイトの運営者情報、掲載基準、広告・スポンサー方針、掲載情報の訂正窓口について説明します。';
const browserTitle = `${pageTitle}｜多磨霊園 お墓ガイド`;

/**
 * mailtoリンクの組み立て（2026-09-02追加）。スポンサー掲載・訂正依頼は
 * 同じメールアドレス（siteConfig.contact.contactEmail）を使うが、
 * subject/bodyを用途ごとに分け、件名だけでも区別できるようにする。
 * bodyの各項目は入力を促すラベルのみで、値は空欄のまま送信者に
 * 埋めてもらう（当サイト側で個人情報を事前入力・保持することはない）。
 */
function buildMailtoHref(email: string, subject: string, bodyLines: string[]): string {
  const params = new URLSearchParams({ subject, body: bodyLines.join('\n') });
  return `mailto:${email}?${params.toString().replace(/\+/g, '%20')}`;
}

const contactEmail = siteConfig.contact.contactEmail;

const sponsorInquirySubject = '多磨霊園 お墓ガイドのスポンサー掲載について';
const sponsorInquiryBodyLines = [
  '会社名：',
  'ご担当者名：',
  '電話番号：',
  '公式サイト：',
  '掲載を希望するサービス：',
  'ご質問：',
];
const sponsorInquiryHref = contactEmail
  ? buildMailtoHref(contactEmail, sponsorInquirySubject, sponsorInquiryBodyLines)
  : null;

const correctionSubject = '多磨霊園 お墓ガイドの掲載情報訂正について';
const correctionBodyLines = ['事業者名：', '訂正箇所：', '正しい情報：', '確認できるURL：', 'その他：'];
const correctionHref = contactEmail
  ? buildMailtoHref(contactEmail, correctionSubject, correctionBodyLines)
  : null;
---

<BaseLayout title={browserTitle} description={description}>
  <Fragment slot="beforeSponsor">
    <h1>{pageTitle}</h1>

    <section aria-labelledby="disclaimer-heading">
      <h2 id="disclaimer-heading">運営者について</h2>
      <p>
        {siteConfig.name}は、多磨霊園周辺の石材店・お墓関連事業者を公開情報のみで比較する民間の情報サイトです。運営者は<a
          href={ROUTES.operator.path}>{siteConfig.operator.name}</a
        >で、東京都・多磨霊園・東京都公園協会とは独立した事業者であり、ロゴ等の使用や委託・公認関係はありません。制度・行政手続きの正確な情報は<a
          href={ROUTES.tetsuzuki.path}>手続きの案内ページ</a
        >から各公式ページをご確認ください。運営者の詳細は<a href={ROUTES.operator.path}>運営者情報ページ</a>をご覧ください。
      </p>
    </section>
  </Fragment>

  <section aria-labelledby="criteria-heading">
    <h2 id="criteria-heading">掲載基準</h2>
    <ul>
      <li>
        調査方法: {editorialPolicy.researchMethod}。掲載事業者への事前ヒアリングは{editorialPolicy.preLaunchInterview
          ? '行っています'
          : '行っていません'}。
      </li>
      <li>
        未確認項目の表示: 公開ページ上で確認できない項目は「{editorialPolicy.unknownLabel}」と表示し、非対応や推測値に置き換えません。
      </li>
      <li>掲載順: {editorialPolicy.rankingPolicy}</li>
    </ul>
    <p>
      掲載データの出典と最終確認日は<a href={ROUTES.sources.path}>情報源ページ</a>で個別に公開しています。
    </p>
  </section>

  <section aria-labelledby="ad-policy-heading">
    <h2 id="ad-policy-heading">広告・スポンサー方針</h2>
    <p>{editorialPolicy.sponsorshipPolicy}</p>
    <p>
      口コミ点数・星評価・独自ランキングや、「おすすめ」「人気」「優良」等の主観的な表現は使用していません。スポンサー枠を設ける場合は、比較データとは別に管理し、「スポンサー」または「広告」であることを明示します。
    </p>
    <div id="sponsor-info-heading" class="contact-block">
      <h3 class="contact-block__heading">スポンサー掲載について</h3>
      <p class="contact-block__body">
        スポンサー枠は4枠です。表示回数とクリック数を計測し、掲載事業者へ月1回ご報告します。墓じまい・管理などのガイド記事からも、関連する石材店一覧へ案内します。
      </p>
      {
        sponsorInquiryHref && (
          <>
            <a class="contact-block__cta" href={sponsorInquiryHref} data-event="sponsor_inquiry_click">
              スポンサー掲載を問い合わせる
            </a>
            <p class="contact-block__email-fallback">
              メールが開かない場合：<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            </p>
          </>
        )
      }
    </div>
  </section>

  <section aria-labelledby="correction-heading">
    <h2 id="correction-heading">掲載情報の訂正</h2>
    <p>
      掲載内容に誤りがありましたら、事業者名、訂正箇所、正しい情報、確認できる公式サイト等のURLをお知らせください。
    </p>
    {
      correctionHref && (
        <>
          <a class="contact-block__cta" href={correctionHref} data-event="correction_request_click">
            訂正を依頼する
          </a>
          <p class="contact-block__email-fallback">
            メールが開かない場合：<a href={`mailto:${contactEmail}`}>{contactEmail}</a>
          </p>
        </>
      )
    }
  </section>
</BaseLayout>

<style>
  /*
   * スポンサー掲載・訂正依頼の問い合わせブロック（2026-09-02追加）。
   * ボタン全体がクリック可能な単一の<a>（mailtoリンク）で、
   * PCではcursor:pointer（アンカー既定）・focus-visibleで明確な
   * フォーカス表示・スマートフォンでも押しやすい高さ（48px以上）を
   * 満たす。メールアプリが開かない場合に備え、ボタン下に
   * メールアドレス自体へのリンクも表示する。
   */
  .contact-block {
    margin-top: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 10px);
    background: var(--color-surface);
  }

  .contact-block__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .contact-block__body {
    margin: 0 0 var(--space-4);
    color: var(--color-text);
    line-height: 1.7;
  }

  .contact-block__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.6em 1.5em;
    border-radius: var(--radius-pill, 999px);
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .contact-block__cta:hover {
    background: var(--color-accent-deep, var(--color-accent));
  }

  .contact-block__cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .contact-block__email-fallback {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-caption, 0.875rem);
  }
</style>
