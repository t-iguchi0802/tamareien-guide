---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonalHero from '../components/common/SeasonalHero.astro';
import { seasonInTokyo } from '../lib/season';
import { ROUTES } from '../lib/routes';
import { getBusinesses, getPublishedNewsArticles } from '../lib/data';
import ServiceFilter from '../components/business/ServiceFilter.astro';
import { getActiveTamaNewsItems } from './_lib/tama-news';
import { formatJaDate, formatShortJaDate } from './_lib/news-display';
import NewsCard from './_partials/NewsCard.astro';

const businesses = getBusinesses();
const preloadImage =
  seasonInTokyo() === 'autumn'
    ? '/images/editorial/magazine-scenes.webp'
    : '/images/editorial/seasonal-scenes.webp';
const tamaNewsItems = getActiveTamaNewsItems();

const newsArticles = getPublishedNewsArticles().slice(0, 3);

type LatestInfoItem =
  | { kind: 'reading'; title: string; publishedAt: string; href: string; slug: string }
  | { kind: 'official'; title: string; publishedAt: string; href: string };

const latestOfficialItem = tamaNewsItems.reduce<(typeof tamaNewsItems)[number] | null>(
  (latest, item) => (!latest || item.publishedAt > latest.publishedAt ? item : latest),
  null,
);
const latestReadingItem = newsArticles[0] ?? null;

let latestInfo: LatestInfoItem | null = null;
if (
  latestReadingItem &&
  (!latestOfficialItem || latestReadingItem.publishedAt >= latestOfficialItem.publishedAt)
) {
  latestInfo = {
    kind: 'reading',
    title: latestReadingItem.title,
    publishedAt: latestReadingItem.publishedAt,
    href: `/news/${latestReadingItem.slug}/`,
    slug: latestReadingItem.slug,
  };
} else if (latestOfficialItem) {
  latestInfo = {
    kind: 'official',
    title: latestOfficialItem.title,
    publishedAt: latestOfficialItem.publishedAt,
    href: latestOfficialItem.sourceUrl,
  };
}

const pageTitle = '多磨霊園 お墓ガイド｜墓じまい・石材店・アクセス・供養';
const description =
  '多磨霊園のお墓・供養に関する地域ガイド。墓じまい、石材店比較、アクセス、みたま堂、樹木葬・合葬、募集・費用などを目的から探せます。';
---

<BaseLayout title={pageTitle} description={description} preloadImage={preloadImage}>
  <Fragment slot="pageTop">
    <SeasonalHero fullWidth />

    {
      latestInfo && latestInfo.kind === 'reading' && (
        <a
          class="latest-info-bar"
          href={latestInfo.href}
          data-event="internal_guide_link_click"
          data-destination={`news_hero_bar:${latestInfo.slug}`}
        >
          <span class="latest-info-bar__label">新着情報</span>
          <span class="latest-info-bar__date">{formatShortJaDate(latestInfo.publishedAt)}</span>
          <span class="latest-info-bar__title">{latestInfo.title}</span>
          <span class="latest-info-bar__arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
    {
      latestInfo && latestInfo.kind === 'official' && (
        <a
          class="latest-info-bar"
          href={latestInfo.href}
          rel="noopener"
          target="_blank"
          data-event="official_procedure_click"
          data-authority="tokyo_park_association"
          data-topic="top_latest_info_bar"
        >
          <span class="latest-info-bar__label">新着情報</span>
          <span class="latest-info-bar__date">{formatShortJaDate(latestInfo.publishedAt)}</span>
          <span class="latest-info-bar__title">{latestInfo.title}</span>
          <span class="latest-info-bar__arrow" aria-hidden="true">
            →
          </span>
        </a>
      )
    }
  </Fragment>

  <Fragment slot="beforeSponsor">
    <ServiceFilter businesses={businesses} mode="link" targetPath={ROUTES.sekizaiten.path} />
  </Fragment>

  <hr class="masonry-rule" />

  {
    (tamaNewsItems.length > 0 || newsArticles.length > 0) && (
      <div id="latest-info" class="latest-info">
        {tamaNewsItems.length > 0 && (
          <section aria-labelledby="tama-news-heading" class="tama-news">
            <h2 id="tama-news-heading">多磨霊園の公式お知らせ</h2>
            <ul class="tama-news__list">
              {tamaNewsItems.map((item) => (
                <li class="tama-news__item">
                  <a
                    class="tama-news__link"
                    href={item.sourceUrl}
                    rel="noopener"
                    target="_blank"
                    data-event="official_procedure_click"
                    data-authority="tokyo_park_association"
                    data-topic="top_tama_news"
                  >
                    {item.title}
                  </a>
                  <p class="tama-news__meta">
                    {item.sourceName}（公開日: {formatJaDate(item.publishedAt)}）
                  </p>
                </li>
              ))}
            </ul>
            <p>
              <a href="https://www.tokyo-park.or.jp/reien/tama/news/index.html">
                多磨霊園の公式お知らせ一覧を見る →
              </a>
            </p>
          </section>
        )}

        {tamaNewsItems.length > 0 && newsArticles.length > 0 && <hr class="masonry-rule" />}

        {newsArticles.length > 0 && (
          <section aria-labelledby="local-news-heading" class="local-news">
            <h2 id="local-news-heading">多磨霊園・周辺の読みもの</h2>
            <ul class="local-news__list">
              {newsArticles.map((article) => (
                <NewsCard article={article} />
              ))}
            </ul>
            <p class="local-news__more">
              <a href={ROUTES.news.path}>読みもの一覧を見る</a>
            </p>
          </section>
        )}
      </div>
    )
  }

  <hr class="masonry-rule" />

  <section aria-labelledby="top-guide-heading" class="top-guide">
    <h2 id="top-guide-heading">多磨霊園ガイド</h2>
    <p class="top-guide__lead">
      お参り・納骨・お墓の手続き・歴史について、公式情報を中心にまとめた記事です。
    </p>
    <div class="top-guide__entries">
      <a
        class="top-guide__entry"
        href={ROUTES.access.path}
        data-event="internal_guide_link_click"
        data-destination="access"
      >
        <span class="top-guide__entry-heading">行き方・園内案内</span>
        <span class="top-guide__entry-description"
          >電車・バス・車での行き方と、門ごとの開閉時間です。</span
        >
      </a>
      <a
        class="top-guide__entry"
        href={ROUTES.guideProcedures.path}
        data-event="internal_guide_link_click"
        data-destination="guide_procedures"
      >
        <span class="top-guide__entry-heading">墓じまい・各種手続き</span>
        <span class="top-guide__entry-description"
          >墓じまいと改葬の違いや、行政手続きの公式リンクです。</span
        >
      </a>
      <a
        class="top-guide__entry"
        href={ROUTES.guideMitamado.path}
        data-event="internal_guide_link_click"
        data-destination="mitamado"
      >
        <span class="top-guide__entry-heading">みたま堂・納骨・合葬</span>
        <span class="top-guide__entry-description"
          >みたま堂の現在の利用状況、樹木葬・合葬施設への入口です。</span
        >
      </a>
      <a
        class="top-guide__entry"
        href={ROUTES.guideHistory.path}
        data-event="internal_guide_link_click"
        data-destination="history"
      >
        <span class="top-guide__entry-heading">歴史・著名人の墓所</span>
        <span class="top-guide__entry-description"
          >1923年開園の経緯と、著名人の墓所についてです。</span
        >
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .latest-info-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    max-width: min(960px, calc(100% - var(--space-4) * 2));
    margin: 0 auto var(--space-6);
    padding: var(--space-3) var(--space-4);
    min-height: var(--tap-target-min);
    border: 1px solid var(--color-border);
    border-left: 6px solid var(--color-accent);
    border-radius: var(--radius-card, 10px);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(36, 54, 75, 0.06);
  }

  .latest-info-bar:hover {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .latest-info-bar__label {
    flex: none;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-tag, 6px);
    background: var(--color-gold);
    color: #ffffff;
    font-weight: 800;
    font-size: var(--font-size-caption, 0.875rem);
  }

  .latest-info-bar__date {
    flex: none;
    color: var(--color-text-muted);
    font-weight: 800;
    font-size: var(--font-size-caption, 0.875rem);
  }

  .latest-info-bar__title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-weight: 800;
    color: var(--color-text);
  }

  @media (max-width: 767px) {
    .latest-info-bar__title {
      flex-basis: 100%;
      white-space: normal;
      overflow: visible;
      text-overflow: unset;
    }
  }

  .latest-info-bar__arrow {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fffdf8;
    font-weight: 700;
  }

  @media (max-width: 767px) {
    .latest-info-bar {
      padding: var(--space-4);
    }

    .latest-info-bar__arrow {
      margin-left: auto;
    }
  }

  .masonry-rule {
    margin-block: var(--space-6);
  }

  .tama-news {
    color: var(--color-text);
  }

  .tama-news h2 {
    font-family: var(--font-family-heading);
    margin: 0 0 var(--space-4);
  }

  .tama-news__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 767px) {
    .tama-news__list {
      grid-template-columns: 1fr;
    }
  }

  .tama-news__item {
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 10px);
    background: var(--color-surface);
  }

  .tama-news__link {
    display: block;
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: none;
    line-height: 1.5;
  }

  .tama-news__link:hover {
    text-decoration: underline;
  }

  .tama-news__meta {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-caption, 0.875rem);
  }

  .latest-info {
    scroll-margin-top: var(--space-6);
  }

  .local-news {
    color: var(--color-text);
  }

  .local-news h2 {
    font-family: var(--font-family-heading);
    margin: 0 0 var(--space-4);
  }

  .local-news__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-3);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  @media (max-width: 767px) {
    .local-news__list {
      grid-template-columns: 1fr;
    }
  }

  .local-news__more {
    margin: 0;
    font-weight: 700;
  }

  .trust p {
    color: inherit;
  }

  .top-guide {
    max-width: 960px;
    margin-inline: auto;
  }

  .top-guide h2 {
    font-family: var(--font-family-heading);
    margin: 0 0 var(--space-2);
  }

  .top-guide__lead {
    margin: 0 0 var(--space-4);
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  .top-guide__entries {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 767px) {
    .top-guide__entries {
      grid-template-columns: 1fr;
    }
  }

  .top-guide__entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5, 1.25rem);
    border: 1px solid var(--color-stone-line);
    border-radius: var(--radius-card);
    background: var(--color-stone-surface);
    color: var(--color-text);
    text-decoration: none;
    min-height: var(--tap-target-min);
  }

  .top-guide__entry:hover {
    background: var(--color-surface);
    border-color: var(--color-accent);
  }

  .top-guide__entry-heading {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .top-guide__entry-description {
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
    line-height: 1.6;
  }
</style>
