---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeasonalHero from '../components/common/SeasonalHero.astro';
import ServiceFilter from '../components/business/ServiceFilter.astro';
import { getBusinesses, getPublishedNewsArticles } from '../lib/data';
import { getActiveTamaNewsItems } from './_lib/tama-news';
import { formatJaDate } from './_lib/news-display';
import NewsCard from './_partials/NewsCard.astro';
import { seasonInTokyo } from '../lib/season';
const businesses = getBusinesses();
const newsArticles = getPublishedNewsArticles().slice(0, 3);
const tamaNewsItems = getActiveTamaNewsItems();
const preloadImage =
  seasonInTokyo() === 'autumn'
    ? '/images/editorial/magazine-scenes.webp'
    : '/images/editorial/seasonal-scenes.webp';
---

<BaseLayout
  title="多磨霊園 お墓ガイド｜墓じまい・石材店・アクセス・供養"
  description="多磨霊園の石材店探しと、墓参りに役立つ地域情報。石材店の比較、墓じまい・管理・納骨、アクセス、歴史や著名人の物語を紹介します。"
  preloadImage={preloadImage}
>
  <Fragment slot="beforeSponsor"><SeasonalHero /></Fragment>
  <section class="home-search" aria-labelledby="home-search-heading">
    <h2 id="home-search-heading">多磨霊園周辺の石材店を探す</h2>
    <p>対応内容や店舗情報を見比べて、相談先を選べます。</p>
    <a class="home-button" href="/sekizaiten/"
      >{businesses.length}社の石材店一覧・比較へ <span aria-hidden="true">→</span></a
    >
    <p class="home-search__note">お墓づくり・納骨・修理・墓じまいなど</p>
  </section>
  <div class="home-utilities">
    <a href="/access/">電車・バス・車での行き方 →</a><a href="/guide/procedures/"
      >墓じまい・お墓の手続き →</a>
  </div>
  <section class="home-editorial" aria-labelledby="home-editorial-heading">
    <h2 class="home-heading" id="home-editorial-heading">多磨霊園を知る、まちを楽しむ</h2>
    <a
      class="home-feature"
      href="/guide/famous-graves/"
      data-event="internal_guide_link_click"
      data-destination="famous_graves"
    >
      <div class="home-scene home-scene--books" role="img" aria-label="本と万年筆のイメージ">
        <span>イメージ</span>
      </div>
      <div>
        <span class="home-category">人と歴史</span><h3>多磨霊園に<br />眠る著名人</h3><p>
          名前の先に、その人の物語がある。<br />人物の一覧を見る →
        </p>
      </div>
    </a>
    <div class="home-stories">
      <a href="/guide/history/" data-event="internal_guide_link_click" data-destination="history"
        ><div class="home-scene home-scene--park" role="img" aria-label="並木道のイメージ">
          <span>イメージ</span>
        </div><div>
          <span class="home-category">まちの歴史</span><h3>多磨霊園は、どのように生まれた？</h3><p>
            開園からの歩みをたどる →
          </p>
        </div></a
      >
      <a href="/kanri/" data-event="internal_guide_link_click" data-destination="kanri"
        ><div class="home-scene home-scene--stone" role="img" aria-label="墓石と供花のイメージ">
          <span>イメージ</span>
        </div><div>
          <span class="home-category">お墓の手入れ</span><h3>清掃・供花を頼める相談先は？</h3><p>
            管理・清掃の対応を見比べる →
          </p>
        </div></a
      >
    </div>
  </section>
  {
    newsArticles.length > 0 && (
      <section class="home-reading" aria-labelledby="local-news-heading">
        <>
          <div class="home-section-bar">
            <>
              <h2 id="local-news-heading" class="home-heading">
                多磨霊園・周辺の読みもの
              </h2>
              <a href="/news/">すべて見る →</a>
            </>
          </div>
          <ul class="home-reading__list">
            {newsArticles.map((article) => (
              <NewsCard article={article} />
            ))}
          </ul>
        </>
      </section>
    )
  }
  <details class="home-filter">
    <summary>相談したい内容から石材店を絞り込む</summary><ServiceFilter
      businesses={businesses}
      mode="link"
      targetPath="/sekizaiten/"
    />
  </details>
  <section class="home-guides" aria-labelledby="home-guides-heading">
    <h2 id="home-guides-heading" class="home-heading">墓参りと、お墓のガイド</h2><div
      class="home-guide-grid"
    >
      <a href="/guide/mitamado/">みたま堂・納骨 <span>→</span></a><a href="/guide/gassou/"
        >合葬埋蔵施設 <span>→</span></a
      ><a href="/guide/application/">霊園の募集・申込み <span>→</span></a><a href="/guide/cost/"
        >お墓にかかる費用 <span>→</span></a
      >
    </div>
  </section>
  <section class="home-official" aria-labelledby="tama-news-heading" id="latest-info">
    <h2 id="tama-news-heading">多磨霊園の公式お知らせ</h2>
    {
      tamaNewsItems.length > 0 && (
        <ul>
          {tamaNewsItems.map((item) => (
            <li>
              <a
                href={item.sourceUrl}
                target="_blank"
                rel="noopener"
                data-event="official_procedure_click"
                data-authority="tokyo_park_association"
                data-topic="top_tama_news"
              >
                {item.title} ↗
              </a>
              <small>
                {item.sourceName}・公開日：{formatJaDate(item.publishedAt)}
              </small>
            </li>
          ))}
        </ul>
      )
    }
    <a href="https://www.tokyo-park.or.jp/reien/tama/news/index.html" target="_blank" rel="noopener"
      >公式サイトのお知らせ一覧へ ↗</a
    >
  </section>
</BaseLayout>
<style>
  .home-search {
    border: 1px solid var(--color-accent);
    background: white;
    padding: 24px;
    text-align: center;
  }
  .home-search h2 {
    font-size: 26px;
    margin: 0 0 12px;
  }
  .home-search p {
    font-size: 14px;
    margin: 8px 0 18px;
  }
  .home-button {
    display: block;
    max-width: 450px;
    margin: auto;
    padding: 14px 18px;
    color: white;
    background: var(--color-accent);
    text-decoration: none;
    font-size: 19px;
    border-radius: 3px;
  }
  .home-button:hover {
    background: #38516b;
  }
  .home-search .home-search__note {
    font-size: 12px;
    margin: 12px 0 0;
    color: var(--color-text-muted);
  }
  .home-utilities {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 16px 0 38px;
  }
  .home-utilities a {
    border: 1px solid #aab0b7;
    text-decoration: none;
    padding: 13px 8px;
    text-align: center;
    font-size: 14px;
  }
  .home-heading {
    font-size: 26px;
    border-left: 3px solid var(--color-gold);
    padding-left: 14px;
    margin: 32px 0 22px;
  }
  .home-feature {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
    align-items: center;
    text-decoration: none;
  }
  .home-feature h3 {
    font: 500 30px/1.6 var(--font-family-heading);
    margin: 12px 0;
  }
  .home-feature p {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .home-category {
    font-size: 12px;
    color: #795820;
    border: 1px solid var(--color-gold);
    padding: 3px 8px;
  }
  .home-scene {
    position: relative;
    aspect-ratio: 1.5;
    background: url('/images/editorial/magazine-scenes.webp') 0 0/200% 200%;
    overflow: hidden;
  }
  .home-scene--books {
    background-position: 0 100%;
  }
  .home-scene--stone {
    background-position: 100% 0;
  }
  .home-scene span {
    position: absolute;
    bottom: 5px;
    right: 6px;
    background: #24364ba6;
    color: white;
    font-size: 10px;
    padding: 1px 5px;
  }
  .home-stories {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
    margin-top: 30px;
  }
  .home-stories > a {
    text-decoration: none;
  }
  .home-stories .home-category {
    display: inline-block;
    margin-top: 14px;
  }
  .home-stories h3 {
    font: 500 22px/1.65 var(--font-family-heading);
    margin: 10px 0;
  }
  .home-stories p {
    font-size: 13px;
    color: var(--color-text-muted);
    margin: 0;
  }
  .home-feature:hover h3,
  .home-stories a:hover h3 {
    text-decoration: underline;
    text-decoration-color: var(--color-gold);
  }
  .home-section-bar {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: center;
  }
  .home-section-bar > a {
    font-size: 13px;
    flex: none;
  }
  .home-reading__list {
    display: grid;
    gap: 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .home-filter {
    margin: 30px 0;
    border-block: 1px solid var(--color-border);
    padding: 10px 0;
  }
  .home-filter > summary {
    min-height: 48px;
    padding: 10px 0;
    font-weight: 600;
    color: var(--color-accent);
  }
  .home-guide-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .home-guide-grid a {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    text-decoration: none;
    background: white;
    border: 1px solid var(--color-border);
    padding: 16px;
    font-size: 15px;
  }
  .home-official {
    margin: 32px 0 0;
    padding: 22px;
    border: 1px solid #aab0b7;
  }
  .home-official h2 {
    font-size: 22px;
    margin: 0 0 15px;
  }
  .home-official ul {
    list-style: none;
    padding: 0;
  }
  .home-official li {
    margin: 16px 0;
  }
  .home-official a {
    font-size: 14px;
  }
  .home-official small {
    display: block;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  @media (max-width: 767px) {
    .home-search {
      padding: 20px 15px;
    }
    .home-search h2 {
      font-size: 22px;
    }
    .home-button {
      font-size: 17px;
    }
    .home-utilities {
      gap: 10px;
      margin-bottom: 28px;
    }
    .home-utilities a {
      font-size: 13px;
    }
    .home-heading {
      font-size: 23px;
    }
    .home-feature {
      display: block;
    }
    .home-feature .home-scene {
      aspect-ratio: 1.8;
    }
    .home-feature .home-category {
      display: inline-block;
      margin-top: 16px;
    }
    .home-feature h3 {
      font-size: 26px;
      margin: 10px 0;
    }
    .home-stories {
      display: block;
    }
    .home-stories > a {
      display: grid;
      grid-template-columns: 38% 1fr;
      gap: 16px;
      align-items: center;
      border-top: 1px solid var(--color-border);
      padding: 18px 0;
    }
    .home-stories .home-category {
      margin-top: 0;
      font-size: 11px;
    }
    .home-stories h3 {
      font-size: 19px;
      margin: 8px 0;
    }
    .home-stories p {
      font-size: 12px;
    }
    .home-section-bar {
      display: block;
    }
    .home-section-bar > a {
      display: inline-block;
      margin: -8px 0 16px;
    }
    .home-guide-grid a {
      font-size: 14px;
      padding: 13px;
    }
    .home-official {
      padding: 18px;
    }
  }
</style>
