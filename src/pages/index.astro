---
/**
 * トップページ・目的から探す入口。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章 / src/lib/routes.ts ROUTES.top
 *
 * editorial-redesign（2026-08-26）: 「業者データベース」ではなく
 * 「目的から相談先を探せる地域ガイド」という方向で全面再設計した。
 * 14社の詳細な一覧・カードグリッドはここに複製せず、共有コンポーネント
 * <ServiceFilter mode="link"> の「この条件で一覧を見る」から
 * /sekizaiten/ へ選択条件（?services=a,b,c）を引き継いで遷移する
 * （困りごと別の入口というこのページの役割を保ちつつ、
 * 「3つの目的→くわしい条件→対応できた件数」の体験は共通化する）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/siteConfig';
import { ROUTES } from '../lib/routes';
import { getBusinesses } from '../lib/data';
import ServiceFilter from '../components/business/ServiceFilter.astro';

const businesses = getBusinesses();
---

<BaseLayout title={siteConfig.name} description={siteConfig.subtitle}>
  <section class="hero" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="hero__heading">多磨霊園のお墓のことを、目的から探す</h1>
    <p class="hero__lead">墓石建立、墓じまい、管理・清掃。公開情報を同じ基準で整理しました。</p>
  </section>

  <hr class="masonry-rule" />

  <section aria-labelledby="service-filter-heading">
    <ServiceFilter businesses={businesses} mode="link" targetPath={ROUTES.sekizaiten.path} />
  </section>

  <hr class="masonry-rule" />

  <section aria-labelledby="trust-heading" class="trust">
    <h2 id="trust-heading">当サイトについて</h2>
    <p>{siteConfig.officialDisclaimer}</p>
    <p>
      多磨霊園周辺の石材店・お墓関連事業者{businesses.length}社について、公開情報のみをもとに中立に整理しています。事前ヒアリングやスポンサー営業は行っていません。掲載順は事業者の推奨順位ではありません。
    </p>
    <p>
      掲載基準・広告方針・訂正窓口は<a href={ROUTES.about.path}>運営方針ページ</a>を、情報源と最終確認日は<a
        href={ROUTES.sources.path}>情報源ページ</a
      >をご覧ください。
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-2);
  }

  .hero__heading {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.45;
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }

  .hero__lead {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-stone-text);
  }

  .masonry-rule {
    margin-block: var(--space-6);
  }

  .trust {
    color: var(--color-text);
  }

  .trust p {
    color: inherit;
  }
</style>
