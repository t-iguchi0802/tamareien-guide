---
/**
 * トップページ・目的から探す入口。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章 / src/lib/routes.ts ROUTES.top
 *
 * editorial-redesign（2026-08-26）: 「業者データベース」ではなく
 * 「目的から相談先を探せる地域ガイド」という方向で全面再設計した。
 * 14社の詳細な一覧・カードグリッドはここに複製せず、共有コンポーネント
 * <ServiceFilter mode="link"> の「この条件で一覧を見る」から
 * /sekizaiten/ へ選択条件（?services=a,b,c）を引き継いで遷移する
 * （困りごと別の入口というこのページの役割を保ちつつ、
 * 「3つの目的→くわしい条件→対応できた件数」の体験は共通化する）。
 *
 * QA監査 M-1（2026-08-26）対応: <ServiceFilter>は自身のルート要素として
 * `aria-labelledby="service-filter-heading"` を持つ<section>を描画するため、
 * ここで同じaria-labelledbyを持つ<section>を重ねてラップしない
 * （同名ランドマークの二重ネストを避けるため、ラップ用のsectionは置かない）。
 *
 * 公開前仕上げ修正（2026-08-26）: 「公開情報をもとに整理しています」という
 * 趣旨の説明が、このページの「当サイトについて」セクションと /sekizaiten/
 * とで異なる文言により重複していたため、指定の推奨文へ統一し、
 * このページの上部（ヒーロー直下）に1回だけ表示するよう移動した
 * （下部の「当サイトについて」からは同趣旨の文を削除し、リンク段落のみ残す）。
 * 「事業者への確認で得た情報は、確認後に随時反映します」という文言により、
 * 事前ヒアリングを実施済みであるとは述べていない（今後確認が得られた場合の
 * 反映方針を示すのみ）。
 *
 * レイアウト刷新（2026-08-26）:
 * - 中央本文内にあった「スポンサー」セクション（1〜4件グリッド／0件時の
 *   「地域スポンサー募集中」案内）を削除し、PC幅（1280px以上）では
 *   中央本文（最大920px）の左右にSponsorSlotを2枠ずつ・計4枠配置する
 *   固定レイアウトへ変更した。1024px以下（タブレット・スマートフォン）
 *   では左右枠を解除し、検索条件セクションの直後に4枠をまとめて
 *   コンパクトな2列グリッドとして表示する。
 *   DOM上は4つのSponsorSlotを1回ずつしか描画せず（表示回数計測の二重化・
 *   スクリーンリーダーでの重複読み上げを避けるため）、
 *   `.top-layout__rails`（モバイル/タブレットでは実グリッド、PCでは
 *   `display: contents`で透過）と`.sponsor-rail`（PCでは実フレックス列、
 *   モバイル/タブレットでは`display: contents`で透過）を入れ子にし、
 *   ブレークポイントごとにどちらか一方だけを「実体のある箱」にすることで、
 *   同じ4要素をCSSだけで配置し直している。
 * - スポンサー表示は検索条件・検索結果件数を一切参照せず、絞り込み操作の
 *   前後でも内容・DOM構造が変化しないことをQAで確認する。
 * - QA監査 M-1（2026-08-27）対応: 4枠のDOM順は「見出し→検索条件→広告→
 *   当サイトについて」とし、1279px以下での視覚順（検索条件の直後に広告）
 *   と一致させた（詳細は下記スタイル直前のコメント参照）。
 * - ヒーローに `public/images/hero-cemetery-v1.png`
 *   （多磨霊園を実際に撮影したものではない、雰囲気を伝えるための画像）を
 *   背景として敷き、薄い生成りのオーバーレイで見出し・説明文の可読性を
 *   確保した。右下に「画像はイメージです」を常時表示し、実際の多磨霊園の
 *   写真であるかのような誤認をさせない。
 * - `.site-main`（BaseLayout共有、既定は960px）の最大幅をこのページの
 *   バンドルCSS内でのみ`:global()`により拡張している（他ページのCSS
 *   バンドルには含まれないため、BaseLayout.astro自体や他ページの
 *   レイアウトには影響しない）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../lib/siteConfig';
import { ROUTES } from '../lib/routes';
import { getBusinesses, getActiveSponsors } from '../lib/data';
import ServiceFilter from '../components/business/ServiceFilter.astro';
import SponsorSlot from '../components/sponsors/SponsorSlot.astro';

const businesses = getBusinesses();
const sponsors = getActiveSponsors();
const sponsorSlots = [sponsors[0] ?? null, sponsors[1] ?? null, sponsors[2] ?? null, sponsors[3] ?? null];
---

<BaseLayout title={siteConfig.name} description={siteConfig.subtitle}>
  <div class="top-layout">
    <section class="hero top-layout__hero" aria-labelledby="hero-heading">
      <h1 id="hero-heading" class="hero__heading">多磨霊園のお墓のことを、目的から探す</h1>
      <p class="hero__lead">墓石建立、墓じまい、管理・清掃。公開情報を同じ基準で整理しました。</p>
      <p class="hero__note">
        掲載情報は、各社のWebサイト等で確認できた公開情報をもとに整理しています。事業者への確認で得た情報は、確認後に随時反映します。
      </p>
      <p class="hero__image-credit">画像はイメージです</p>
    </section>

    <div class="top-layout__filter">
      <hr class="masonry-rule" />
      <ServiceFilter businesses={businesses} mode="link" targetPath={ROUTES.sekizaiten.path} />
      <hr class="masonry-rule" />
    </div>

    <!--
      QA監査 M-1（2026-08-27）対応: 以前はこのdivを本文の最後（trustの後）に
      置いていたが、1279px以下ではgrid-areaにより検索条件とtrustの「間」に
      視覚的に配置されるため、DOM順（＝キーボードのTab順）と視覚順が
      食い違っていた（sponsors.jsonが空でリンクを持たない現在は無症状だが、
      実際のスポンサーリンクが入ると、trust内のリンクへ到達した直後に
      画面上で1つ上にあるスポンサーへ視覚的に「後戻り」する形になる）。
      視覚順と一致させるため、DOM上もfilterとtrustの間に移動した。
      PC幅（1280px以上）ではgrid-areaが左右レールへ配置し直すため、
      このDOM位置の変更によるデスクトップ表示への影響はない
      （grid-areaによる配置はDOM順に依存しない）。
    -->
    <div class="top-layout__rails" data-sponsor-root aria-label="広告">
      <div class="sponsor-rail sponsor-rail--left">
        <SponsorSlot sponsor={sponsorSlots[0]} />
        <SponsorSlot sponsor={sponsorSlots[1]} />
      </div>
      <div class="sponsor-rail sponsor-rail--right">
        <SponsorSlot sponsor={sponsorSlots[2]} />
        <SponsorSlot sponsor={sponsorSlots[3]} />
      </div>
    </div>

    <section aria-labelledby="trust-heading" class="trust top-layout__trust">
      <h2 id="trust-heading">当サイトについて</h2>
      <p>{siteConfig.officialDisclaimer}</p>
      <p>
        多磨霊園周辺の石材店・お墓関連事業者{businesses.length}社を掲載しています。掲載順は事業者の推奨順位ではありません。掲載基準・広告方針・訂正窓口は<a
          href={ROUTES.about.path}>運営方針ページ</a
        >を、情報源と最終確認日は<a href={ROUTES.sources.path}>情報源ページ</a>をご覧ください。
      </p>
    </section>
  </div>

  <script>
    import { trackSponsorImpression } from '../lib/analytics/events';

    (function initSponsorImpressions() {
      const root = document.querySelector<HTMLElement>('[data-sponsor-root]');
      if (!root) return;
      if (typeof IntersectionObserver === 'undefined') return;

      const slots = Array.from(root.querySelectorAll<HTMLElement>('[data-sponsor-id]'));
      if (slots.length === 0) return;

      const pagePath = window.location.pathname;
      const seen = new Set<string>();

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const sponsorId = el.getAttribute('data-sponsor-id');
            const campaignId = el.getAttribute('data-campaign-id');
            if (!sponsorId || !campaignId || seen.has(sponsorId)) return;
            seen.add(sponsorId);
            trackSponsorImpression({ sponsor_id: sponsorId, campaign_id: campaignId, page_path: pagePath });
            observer.unobserve(el);
          });
        },
        { threshold: 0.5 },
      );

      slots.forEach((slot) => observer.observe(slot));
    })();
  </script>
</BaseLayout>

<style>
  /*
   * このページのCSSバンドルにのみ含まれる（Astroはコンポーネント単位で
   * CSSを分割し、ページが実際にimportしたコンポーネントのCSSだけを
   * そのページのバンドルに含める）ため、:global()を使っても
   * 他ページの.site-mainには影響しない。TOPページだけ、左右の
   * 広告枠ぶん本文コンテナを広げるための上書き。
   */
  :global(.site-main) {
    max-width: 1400px;
  }

  .top-layout {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'hero'
      'filter'
      'sponsors'
      'trust';
    gap: var(--space-6);
  }

  .top-layout__hero {
    grid-area: hero;
  }

  .top-layout__filter {
    grid-area: filter;
  }

  .top-layout__trust {
    grid-area: trust;
  }

  /* --- スポンサー4枠: モバイル・タブレット（既定）は2列グリッド --- */
  .top-layout__rails {
    grid-area: sponsors;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .sponsor-rail {
    /* モバイル・タブレットでは箱を持たせず、中の2枠を
       .top-layout__rails の2列グリッドへ直接参加させる。 */
    display: contents;
  }

  /* --- PC幅（1280px以上）: 左右2枠ずつのサイドレールへ切り替え --- */
  @media (min-width: 1280px) {
    .top-layout {
      grid-template-columns: minmax(140px, 180px) minmax(0, 1fr) minmax(140px, 180px);
      grid-template-areas:
        'rail-left hero rail-right'
        'rail-left filter rail-right'
        'rail-left trust rail-right';
      column-gap: 22px;
      justify-content: center;
      align-items: start;
    }

    .top-layout__hero,
    .top-layout__filter,
    .top-layout__trust {
      max-width: 920px;
    }

    /* ラップ用の2列グリッドを透過させ、左右レールを.top-layoutの
       直接の子として配置し直す。 */
    .top-layout__rails {
      display: contents;
    }

    .sponsor-rail {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      position: sticky;
      top: var(--space-4);
      align-self: start;
    }

    .sponsor-rail--left {
      grid-area: rail-left;
    }

    .sponsor-rail--right {
      grid-area: rail-right;
    }
  }

  /* --- ヒーロー（背景画像＋オーバーレイ） --- */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: clamp(260px, 34vw, 400px);
    padding: var(--space-8) var(--space-6);
    border-radius: var(--radius-card);
    overflow: hidden;
    background-image: url('/images/hero-cemetery-v1.png');
    background-size: cover;
    background-position: center 40%;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    /* --color-bgベースの生成りを高い不透明度で重ね、画像自体は
       目立たせすぎない程度に淡く見せる。見出し・本文のコントラストを
       確保するための主要な手段。0.90は、画像内で最も暗いピクセル
       （深い木陰、raw RGB [20,18,12] 相当）にテキストが重なった
       最悪ケースでも、.hero__lead/.hero__note が使う
       --color-stone-text とのコントラスト比が4.5:1（WCAG AA）を
       上回るように、Canvas合成による実測（0.80刻みで検証）を経て
       決定した値（4.69:1を確保。.hero__heading側の--color-textは
       同条件で10.56:1）。 */
    background: rgba(247, 242, 231, 0.9);
  }

  .hero__heading,
  .hero__lead,
  .hero__note {
    position: relative;
    z-index: 1;
  }

  .hero__heading {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 4.5vw, 2.75rem);
    line-height: 1.45;
    letter-spacing: 0.01em;
    margin: 0 0 var(--space-3);
    color: var(--color-text);
  }

  .hero__lead {
    margin: 0;
    font-size: 1.15rem;
    color: var(--color-stone-text);
  }

  .hero__note {
    margin: var(--space-3) 0 0;
    font-size: var(--font-size-label, 0.9375rem);
    color: var(--color-stone-text);
  }

  .hero__image-credit {
    position: absolute;
    z-index: 1;
    right: var(--space-3);
    bottom: var(--space-2);
    margin: 0;
    padding: 0.15em 0.6em;
    border-radius: var(--radius-tag);
    background: rgba(255, 255, 255, 0.6);
    color: var(--color-stone-text);
    font-size: var(--font-size-caption, 0.875rem);
  }

  .masonry-rule {
    margin-block: var(--space-6);
  }

  .trust {
    color: var(--color-text);
  }

  .trust p {
    color: inherit;
  }
</style>
