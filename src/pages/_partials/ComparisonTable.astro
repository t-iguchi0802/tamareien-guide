---
/**
 * 比較表（PC用 <table> ＋ モバイル用カード相当マークアップ）。
 *
 * `_partials` はAstroのルーティング対象外（アンダースコア始まり）。
 * src/pages/** の担当範囲内に閉じた内部実装であり、統合時には
 * src/types/components.ts の ComparisonTableProps 契約に沿った
 * feature/ui-components 側の <ComparisonTable> へ差し替え可能な
 * 構造（props: businesses, visibleServices）にしてある。
 *
 * JavaScriptなしで表・カードとも初期HTMLに存在する（CSSのみで
 * 表示切替。JS未実行でも比較表・重要リンクが読める）。
 */
import type { Business, ServiceKey } from '../../types/business';
import { statusToDisplayLabel } from '../../lib/data/verificationStatus';
import { SERVICE_LABELS, buildMapSearchUrl, buildTelHref } from '../_lib/business-display';

interface Props {
  businesses: Business[];
  visibleServices: ServiceKey[];
  caption: string;
}

const { businesses, visibleServices, caption } = Astro.props;
---

<div class="comparison-table">
  <div class="comparison-table__scroll">
    <table>
      <caption>{caption}</caption>
      <thead>
        <tr>
          <th scope="col">事業者名</th>
          <th scope="col">所在地</th>
          {visibleServices.map((key) => <th scope="col">{SERVICE_LABELS[key]}</th>)}
          <th scope="col">連絡・アクセス</th>
        </tr>
      </thead>
      <tbody>
        {
          businesses.map((business) => (
            <tr>
              <th scope="row">
                {business.contact.websiteUrl ? (
                  <a href={business.contact.websiteUrl} rel="noopener" target="_blank">
                    {business.name}
                  </a>
                ) : (
                  business.name
                )}
              </th>
              <td>
                {business.location.city}
                {business.location.nearestGateStatus === 'confirmed' && business.location.nearestGate
                  ? `（${business.location.nearestGate}）`
                  : ''}
              </td>
              {visibleServices.map((key) => <td>{statusToDisplayLabel(business.services[key])}</td>)}
              <td>
                <ul class="comparison-table__actions">
                  {business.contact.phone && (
                    <li>
                      <a href={buildTelHref(business.contact.phone)}>電話 {business.contact.phone}</a>
                    </li>
                  )}
                  <li>
                    <a href={buildMapSearchUrl(business)} rel="noopener" target="_blank">
                      地図で見る
                    </a>
                  </li>
                  {business.contact.websiteUrl && (
                    <li>
                      <a href={business.contact.websiteUrl} rel="noopener" target="_blank">
                        公式サイト
                      </a>
                    </li>
                  )}
                  {!business.contact.websiteUrl && business.contact.directoryUrl && (
                    <li>
                      <a href={business.contact.directoryUrl} rel="noopener" target="_blank">
                        第三者掲載ページ
                      </a>
                    </li>
                  )}
                </ul>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <ul class="comparison-table__cards" aria-label={caption}>
    {
      businesses.map((business) => (
        <li class="comparison-table__card">
          <h3>
            {business.contact.websiteUrl ? (
              <a href={business.contact.websiteUrl} rel="noopener" target="_blank">
                {business.name}
              </a>
            ) : (
              business.name
            )}
          </h3>
          <p class="comparison-table__card-address">
            {business.location.prefecture}
            {business.location.city}
            {business.location.addressLine}
            {business.location.nearestGateStatus === 'confirmed' && business.location.nearestGate
              ? `（${business.location.nearestGate}）`
              : ''}
          </p>
          <dl class="comparison-table__card-services">
            {visibleServices.map((key) => (
              <>
                <dt>{SERVICE_LABELS[key]}</dt>
                <dd>{statusToDisplayLabel(business.services[key])}</dd>
              </>
            ))}
          </dl>
          <ul class="comparison-table__actions">
            {business.contact.phone && (
              <li>
                <a href={buildTelHref(business.contact.phone)}>電話 {business.contact.phone}</a>
              </li>
            )}
            <li>
              <a href={buildMapSearchUrl(business)} rel="noopener" target="_blank">
                地図で見る
              </a>
            </li>
            {business.contact.websiteUrl && (
              <li>
                <a href={business.contact.websiteUrl} rel="noopener" target="_blank">
                  公式サイト
                </a>
              </li>
            )}
            {!business.contact.websiteUrl && business.contact.directoryUrl && (
              <li>
                <a href={business.contact.directoryUrl} rel="noopener" target="_blank">
                  第三者掲載ページ
                </a>
              </li>
            )}
            {business.contact.contactUrl && (
              <li>
                <a href={business.contact.contactUrl} rel="noopener" target="_blank">
                  問い合わせページ
                </a>
              </li>
            )}
          </ul>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .comparison-table__scroll {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
  }
  caption {
    text-align: left;
    font-weight: 700;
    margin-bottom: var(--space-2, 0.5rem);
  }
  th,
  td {
    border: 1px solid var(--color-border, #dcdcd4);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--color-accent-soft, #e7ede8);
  }
  .comparison-table__actions {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .comparison-table__cards {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-direction: column;
    gap: var(--space-4, 1rem);
  }
  .comparison-table__card {
    border: 1px solid var(--color-border, #dcdcd4);
    border-radius: 0.5rem;
    padding: var(--space-4, 1rem);
    background: var(--color-surface, #fff);
  }
  .comparison-table__card h3 {
    margin: 0 0 var(--space-2, 0.5rem);
  }
  .comparison-table__card-address {
    margin: 0 0 var(--space-3, 0.75rem);
    color: var(--color-text-muted, #55584f);
  }
  .comparison-table__card-services {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.75rem;
    margin: 0 0 var(--space-3, 0.75rem);
  }
  .comparison-table__card-services dt {
    color: var(--color-text-muted, #55584f);
  }
  .comparison-table__card-services dd {
    margin: 0;
    text-align: right;
  }

  @media (max-width: 640px) {
    .comparison-table__scroll {
      display: none;
    }
    .comparison-table__cards {
      display: flex;
    }
  }
</style>
