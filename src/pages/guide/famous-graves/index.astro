---
import '../../../styles/guide-article.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ROUTES } from '../../../lib/routes';
import { GUIDE_SOURCES } from '../../_lib/guide-sources';
import PersonCard from '../../../components/common/PersonCard.astro';
import { FAMOUS_PROFILES, FAMOUS_PICKS, compactName } from '../../_lib/famous-profiles';
import { FAMOUS_GRAVES } from '../../_lib/famous-graves-data';
import { buildArticleJsonLd } from '../../../lib/seo';

const pageTitle = '多磨霊園に眠る著名人｜名前から墓所を探す';
const description =
  '多磨霊園にある著名人の墓所を、名前の五十音順から探せます。氏名・分野・墓所の場所（区・種・側・番）は東京都公園協会の公式案内図の表記のとおりです。';

// 2026-09-02、本文の刷新（「このページで分かること」節・代表例カードの削除、
// 「名前から探す」アコーディオンへの変更）に伴い更新日を当日付へ更新した
// （ビルド日時での自動更新ではなく、実際の本文変更に伴う更新）。
const checkedAtJa = '2026年11月13日';

const articleJsonLd = buildArticleJsonLd({
  path: ROUTES.guideFamousGraves.path,
  headline: '多磨霊園に眠る著名人',
  description,
  datePublished: '2026-08-27',
  dateModified: '2026-11-13',
  image: '/images/hero-cemetery-photo-v2.webp',
});

// 公式PDF内の五十音インデックス（ア・カ・サ・タ・ナ・ハ・マ・ヤ・ワ）の順に
// そのままグループ化する。当サイト独自の分類・並べ替えは行っていない。
// 各グループの人数（entries.length）は正本データFAMOUS_GRAVESから
// ビルド時に算出する（固定値をハードコードしない）。
const kanaOrder = ['ア', 'カ', 'サ', 'タ', 'ナ', 'ハ', 'マ', 'ヤ', 'ワ'] as const;
const groups = kanaOrder
  .map((kana) => {
    const entries = FAMOUS_GRAVES.filter((entry) => entry.kana === kana);
    const featured = (FAMOUS_PICKS[kana] ?? []).flatMap((name) =>
      entries.filter((entry) => compactName(entry.name) === name),
    );
    return { kana, entries, featured, rest: entries.filter((entry) => !featured.includes(entry)) };
  })
  .filter((group) => group.entries.length > 0);
---

<BaseLayout
  title={pageTitle}
  description={description}
  ogType="article"
  extraJsonLd={[articleJsonLd]}
>
  <Fragment slot="beforeSponsor">
    <article class="article">
      <p class="article__eyebrow">
        <a href={ROUTES.guide.path}>多磨霊園ガイド</a> ／ 多磨霊園の歴史・著名人
      </p>
      <h1>多磨霊園に眠る著名人</h1>
      <p class="article__meta">更新日：{checkedAtJa}</p>

      <div
        class="article__hero-photo"
        style="background-image:url('/images/editorial/magazine-scenes.webp');background-size:200% 200%;background-position:0 100%;"
        role="img"
        aria-label="本と万年筆のイメージ"
      >
      </div>
      <p class="article__hero-photo__credit">イメージ（生成画像）</p>

      <p>
        物語を紡いだ作家、時代を動かした政治家、新しい表現を生んだ芸術家。多磨霊園に眠る人々の名前と、その足跡をたどります。
      </p>
    </article>
  </Fragment>

  <div class="article">
    <section aria-labelledby="famous-list-heading">
      <h2 id="famous-list-heading">名前から探す</h2>
      <p>
        各行の人物を一部ご紹介しています。「ほか〇人を見る」を開くと、その行の全員を確認できます。
      </p>
      <div class="people-index">
        <nav class="people-kana" aria-label="五十音の行へ移動">
          {groups.map((group) => <a href={`#people-${group.kana}`}>{group.kana}</a>)}
        </nav>
        <label class="people-search" hidden data-people-search
          >名前・作品・分野から検索<input
            type="search"
            placeholder="例：江戸川乱歩、山月記"
            autocomplete="off"
            data-people-input
          /></label
        >
      </div>
      <p class="people-results" role="status" data-people-results hidden></p>
      <div class="people-groups">
        {
          groups.map((group) => (
            <section class="people-group" id={`people-${group.kana}`} data-people-group>
              <div class="people-group__title">
                <>
                  <h3>{group.kana}行</h3>
                  <span>{group.entries.length}人</span>
                </>
              </div>
              <div class="people-cards">
                {group.featured.map((entry) => (
                  <PersonCard entry={entry} />
                ))}
              </div>
              {group.rest.length > 0 ? (
                <details class="people-more">
                  <summary>
                    <span class="people-more__closed">ほか{group.rest.length}人を見る</span>
                    <span class="people-more__open">一覧を閉じる</span>
                    <span class="people-more__icon" aria-hidden="true">
                      ＋
                    </span>
                  </summary>
                  <div class="people-cards people-cards--rest">
                    {group.rest.map((entry) => (
                      <PersonCard entry={entry} />
                    ))}
                  </div>
                </details>
              ) : (
                <p class="people-all">この行は全員を表示しています</p>
              )}
            </section>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="famous-howto-heading">
      <h2 id="famous-howto-heading">墓所の探し方</h2>
      <p>
        上の一覧にある「区・種・側・番」は、墓所の場所を表す公式の住所のようなものです。控えてから、下記の公式園内案内図（PDF）で区の位置関係を確認できます。園内の案内所（正門を入ってすぐ右側の管理事務所）でも紙の案内図を確認できます。
      </p>
    </section>

    <section aria-labelledby="famous-manner-heading">
      <h2 id="famous-manner-heading">墓参時の注意</h2>
      <div class="article__callout article__callout--warm">
        <p class="article__callout__eyebrow">お出かけ前に</p>
        <p>
          東京都公園協会の公式ページでは、霊園を訪れる際のマナーとして次のような点が案内されています。
        </p>
        <ul>
          <li>霊園は慰霊の場所であり、節度をもって静かに散策すること。</li>
          <li>許可なく他人の墓所に立ち入らないこと。</li>
          <li>園内道路を横断するときは、車に注意すること（一般車両も通行します）。</li>
          <li>ごみは持ち帰り、草花や生き物を採ったり、生き物にえさを与えたりしないこと。</li>
          <li>貴重品の管理など、防犯にも注意すること。</li>
        </ul>
        <p>
          また、一部の墓所はご遺族の意向により公式案内図に掲載されていないことも、公式ページで案内されています。掲載されている場合でも、個人のお墓であることに変わりはないため、静かに見学しましょう。
        </p>
      </div>
    </section>

    <section aria-labelledby="famous-map-heading">
      <h2 id="famous-map-heading">公式案内図</h2>
      <div class="article__button-row">
        <a
          class="article__button"
          href={GUIDE_SOURCES.tamaMapPdf.url}
          rel="noopener"
          target="_blank"
          data-event="official_procedure_click"
          data-authority="tokyo_park_association"
          data-topic="famous_graves_map_pdf">公式園内案内図を開く（PDF）</a
        >
      </div>
    </section>

    <section aria-labelledby="famous-sources-heading">
      <h2 id="famous-sources-heading">情報源・確認日</h2>
      <ul class="article__sources">
        <li>
          <a href={GUIDE_SOURCES.tamaMapPdf.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaMapPdf.publisher}「{GUIDE_SOURCES.tamaMapPdf.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaMapPdf.checkedAt}） —
          著名人墓所一覧（氏名・主要経歴・区・種・側・番）、墓所の場所の確認方法の出典
        </li>
        <li>
          <a href={GUIDE_SOURCES.tamaTourManner.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaTourManner.publisher}「{GUIDE_SOURCES.tamaTourManner.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaTourManner.checkedAt}） — 「墓参時の注意」の出典
        </li>
      </ul>
      <details class="profile-sources">
        <summary>人物紹介の参考資料（2026年11月13日確認）</summary><ul>
          {
            Object.entries(FAMOUS_PROFILES).map(([name, profile]) => (
              <li>
                <a href={profile.source} target="_blank" rel="noopener">
                  {name}の紹介に用いた資料 ↗
                </a>
              </li>
            ))
          }
        </ul>
      </details>
      <p><a href={ROUTES.about.path}>掲載してほしい情報・訂正のご連絡はこちら</a></p>
    </section>
  </div>

  <div class="article">
    <section aria-labelledby="famous-related-heading">
      <h2 id="famous-related-heading">関連ページ</h2>
      <ul class="article__related-grid">
        <li>
          <a
            class="article__related-card"
            href={ROUTES.guideHistory.path}
            data-event="internal_guide_link_click"
            data-destination="history">多磨霊園の歴史を見る</a>
        </li>
        <li>
          <a
            class="article__related-card"
            href={ROUTES.access.path}
            data-event="internal_guide_link_click"
            data-destination="access">多磨霊園への行き方を見る</a>
        </li>
        <li>
          <a
            class="article__related-card"
            href={ROUTES.guide.path}
            data-event="internal_guide_link_click"
            data-destination="guide_index">多磨霊園ガイド一覧を見る</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const search = document.querySelector<HTMLElement>('[data-people-search]');
  const input = document.querySelector<HTMLInputElement>('[data-people-input]');
  const results = document.querySelector<HTMLElement>('[data-people-results]');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-people-group]'));
  const previous = new Map<HTMLDetailsElement, boolean>();
  let searching = false;
  const normalize = (text: string) => text.normalize('NFKC').replace(/\s/g, '').toLowerCase();
  if (search && input && results) {
    search.hidden = false;
    input.addEventListener('input', () => {
      const query = normalize(input.value);
      if (query && !searching)
        groups.forEach((group) => {
          const details = group.querySelector('details');
          if (details) previous.set(details, details.open);
        });
      let total = 0;
      groups.forEach((group) => {
        let found = 0;
        group.querySelectorAll<HTMLElement>('[data-person]').forEach((card) => {
          const matches = !query || normalize(card.textContent ?? '').includes(query);
          card.hidden = !matches;
          if (matches) found++;
        });
        group.hidden = found === 0;
        total += found;
        const details = group.querySelector('details');
        if (details) {
          if (query) {
            details.open = true;
            details.hidden = !Array.from(
              details.querySelectorAll<HTMLElement>('[data-person]'),
            ).some((card) => !card.hidden);
          } else {
            details.hidden = false;
            details.open = previous.get(details) ?? false;
          }
        }
      });
      searching = Boolean(query);
      results.hidden = !query;
      results.textContent = total
        ? `${total}人が見つかりました。`
        : '該当する人物が見つかりません。名前の一部や別の言葉でお試しください。';
      if (!query) previous.clear();
    });
  }
</script>
<style>
  .people-index {
    border-block: 1px solid var(--color-border);
    padding: 20px 0;
    margin-bottom: 30px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .people-kana {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .people-kana a {
    display: grid;
    place-items: center;
    min-width: 40px;
    min-height: 44px;
    font: 22px var(--font-family-heading);
    text-decoration: none;
  }
  .people-kana a:hover {
    background: var(--color-accent);
    color: white;
  }
  .people-search {
    font-size: 13px;
    color: var(--color-text-muted);
    flex: 1;
    min-width: 230px;
  }
  .people-search input {
    display: block;
    width: 100%;
    border: 1px solid #aab6c1;
    background: white;
    padding: 12px;
    margin-top: 5px;
    border-radius: 3px;
    color: var(--color-accent);
    font-size: 16px;
  }
  .people-results {
    font-size: 14px;
  }
  .people-group {
    display: grid;
    grid-template-columns: 70px minmax(0, 1fr);
    gap: 0 26px;
    margin-bottom: 28px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 24px;
  }
  .people-group__title {
    grid-row: 1/3;
    padding-top: 16px;
  }
  .people-group__title h3 {
    font: 500 29px/1.5 var(--font-family-heading);
    margin: 0 0 6px;
  }
  .people-group__title span {
    font-size: 12px;
    color: #795820;
  }
  .people-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 24px;
  }
  .people-more {
    grid-column: 2;
  }
  .people-more summary {
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--color-border);
    font-size: 14px;
    list-style: none;
    color: var(--color-accent);
  }
  .people-more summary::-webkit-details-marker {
    display: none;
  }
  .people-more__icon {
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: var(--color-accent-soft);
    border-radius: 50%;
    font-size: 20px;
  }
  .people-more__open {
    display: none;
  }
  .people-more[open] .people-more__closed {
    display: none;
  }
  .people-more[open] .people-more__open {
    display: inline;
  }
  .people-more[open] .people-more__icon {
    transform: rotate(45deg);
  }
  .people-all {
    grid-column: 2;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .profile-sources {
    margin: 24px 0;
  }
  .profile-sources summary {
    min-height: 44px;
    padding: 8px 0;
  }
  .profile-sources li {
    font-size: 14px;
    margin-block: 10px;
  }
  @media (max-width: 767px) {
    .people-group {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 24px;
    }
    .people-group__title {
      display: flex;
      align-items: center;
      gap: 14px;
      grid-row: auto;
      padding: 0 0 10px;
    }
    .people-group__title h3 {
      margin: 0;
    }
    .people-cards {
      grid-template-columns: 1fr;
    }
    .people-more,
    .people-all {
      grid-column: 1;
    }
    .people-search {
      flex-basis: 100%;
    }
    .people-kana {
      gap: 0;
    }
    .people-kana a {
      min-width: 34px;
    }
  }
</style>
