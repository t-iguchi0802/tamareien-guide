---
/**
 * 多磨霊園に眠る著名人｜公式案内図で巡る墓所ガイド。
 * 正本: src/lib/routes.ts ROUTES.guideFamousGraves（2026-08-27新設）。
 *
 * 完成化（2026-09-01、ミチの全体校正・指摘1対応）:
 * 2026-08-27時点では、公式案内図PDFがこの実行環境でテキスト抽出できず、
 * 個別の氏名・区画を掲載できなかった（下記「旧・意図的な範囲縮小について」
 * 参照）。2026-09-01、Pythonの PyMuPDF ライブラリでPDFの単語座標を
 * 直接読み取る方法に切り替えたところ、公式PDF内の「■著名人墓所」表
 * （氏名・主要経歴・区・種・側・番）を機械的に抽出できることを確認したため、
 * 本ページを完成させた。
 *
 * データの出典・検証方法・訂正箇所の詳細は
 * src/pages/_lib/famous-graves-data.ts の先頭コメントを参照
 * （143名全員を公式PDFのとおり収録しており、Claude独自の「有名度」による
 * 取捨選択は行っていない。新旧2版のPDFを機械的に突き合わせ、一致しない
 * 2件だけを個別に検証・記録した）。
 *
 * 旧・意図的な範囲縮小について（2026-08-27、参考として残す）:
 * ユーザー指示では「公開済みの公式案内図に掲載されている著名人だけを対象に、
 * 区画（区・種・側・番）まで表示する」ことが求められていた。実装時
 * （2026-08-27）はPDFのテキスト抽出・画像レンダリングがこの実行環境で
 * できず、内容を直接確認できなかったため、氏名・区画を掲載せず案内図への
 * リンクだけを置いていた。Wikipediaの著名人一覧は二次資料であるため、
 * 区画番号の転記には使わなかった。
 *
 * スポンサー分散レイアウト対応（2026-09-01、ミチの全体校正・指摘3対応）:
 * 本文を3つに分け、BaseLayout.astroの`articleIntro`／既定／`articleTail`
 * スロットへ渡すようにした（詳細はsrc/layouts/BaseLayout.astro該当コメント
 * 参照）。articleIntro=「このページで分かること」（最初の内容ブロック）、
 * 既定スロット=「著名人墓所一覧」〜「情報源・確認日」、articleTail=
 * 「関連ページ」。見出し・本文・データは変更していない。
 *
 * モバイル最優先レビュー対応（2026-09-01）: 導入部に写真
 * （hero-cemetery-photo-v2.png、/access/とは異なるクロップで再利用。
 * 新規取得はしていない）を追加し、「墓参時の注意」を薄い暖色の注意欄
 * （.article__callout--warm）にし、関連ページをカード化した。
 * 見出し・本文・データは変更していない。
 *
 * H1分割・代表例の追加（2026-09-01、ミチのモバイル優先UI・文章校正対応
 * 「著名人ページ」節）: H1を「多磨霊園に眠る著名人」に短縮した。
 *
 * 説明臭い文章の削除・名前から探すアコーディオンへの刷新（2026-09-02、
 * ミチの編集改善・SEO/AIO対応「著名人ページ」節）:
 * - 「このページで分かること」節と「一覧の入口（例、先頭6名）」を削除した。
 *   前者はサイト制作側の説明（「このページでは…まとめています」）、
 *   後者も一覧の代わりとなるサンプル紹介にすぎず、実際の利用者が
 *   知りたい内容（誰が眠っているか、どう探すか）を直接書く方針へ変更した。
 * - 補足文（.article__lead）は使わず、指定の冒頭文をH1直後の本文
 *   段落にした（「補足は原則不要」の指定に合わせた）。
 * - 見出しを「著名人墓所一覧」→「名前から探す」に変更し、旧
 *   「『ア』から始まる方（○名）を見る」という表現を「ア行 ○人」（行・人数を
 *   別スパンにし、CSSのgapで間隔を取る）へ改めた。人数は下記`groups`
 *   （FAMOUS_GRAVES、正本データ）から実行時に算出しており、固定値ではない。
 * - 開閉行は<details>/<summary>のまま、行全体タップ・cursor:pointer・
 *   hover時の薄い緑地・右端の開閉矢印（開時に回転）・48px以上の高さ・
 *   キーボード操作・明確なフォーカス表示を満たすCSSを追加した
 *   （詳細は下記<style>の.kana-accordion__summary参照）。
 * - 人物の並び順・掲載対象は変更していない（143名、公式PDFの五十音順の
 *   まま、Claude独自の有名度判断・順位付けは行っていない。公式資料で
 *   確認できない人物の追加、人物写真の使用もしていない）。
 * - title/descriptionを「多磨霊園に眠る著名人｜名前から墓所を探す」に更新した。
 */
import '../../../styles/guide-article.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ROUTES } from '../../../lib/routes';
import { GUIDE_SOURCES } from '../../_lib/guide-sources';
import { FAMOUS_GRAVES } from '../../_lib/famous-graves-data';
import { buildArticleJsonLd } from '../../../lib/seo';

const pageTitle = '多磨霊園に眠る著名人｜名前から墓所を探す';
const description =
  '多磨霊園にある著名人の墓所を、名前の五十音順から探せます。氏名・分野・墓所の場所（区・種・側・番）は東京都公園協会の公式案内図の表記のとおりです。';

// 2026-09-02、本文の刷新（「このページで分かること」節・代表例カードの削除、
// 「名前から探す」アコーディオンへの変更）に伴い更新日を当日付へ更新した
// （ビルド日時での自動更新ではなく、実際の本文変更に伴う更新）。
const checkedAtJa = '2026年9月2日';

const articleJsonLd = buildArticleJsonLd({
  path: ROUTES.guideFamousGraves.path,
  headline: '多磨霊園に眠る著名人',
  description,
  datePublished: '2026-08-27',
  dateModified: '2026-09-02',
  image: '/images/hero-cemetery-photo-v2.png',
});

// 公式PDF内の五十音インデックス（ア・カ・サ・タ・ナ・ハ・マ・ヤ・ワ）の順に
// そのままグループ化する。当サイト独自の分類・並べ替えは行っていない。
// 各グループの人数（entries.length）は正本データFAMOUS_GRAVESから
// ビルド時に算出する（固定値をハードコードしない）。
const kanaOrder = ['ア', 'カ', 'サ', 'タ', 'ナ', 'ハ', 'マ', 'ヤ', 'ワ'] as const;
const groups = kanaOrder
  .map((kana) => ({ kana, entries: FAMOUS_GRAVES.filter((entry) => entry.kana === kana) }))
  .filter((group) => group.entries.length > 0);

function formatPlot(entry: (typeof FAMOUS_GRAVES)[number]): string {
  return `${entry.block}区 ${entry.section}種 ${entry.side}側 ${entry.number}番`;
}
---

<BaseLayout title={pageTitle} description={description} ogType="article" extraJsonLd={[articleJsonLd]}>
  <Fragment slot="beforeSponsor">
    <article class="article">
      <p class="article__eyebrow"><a href={ROUTES.guide.path}>多磨霊園ガイド</a> ／ 多磨霊園の歴史・著名人</p>
      <h1>多磨霊園に眠る著名人</h1>
      <p class="article__meta">更新日：{checkedAtJa}</p>

      <div class="article__hero-photo" style="background-image:url('/images/hero-cemetery-photo-v2.png');background-position:center 30%;"></div>
      <p class="article__hero-photo__credit">イメージ写真</p>

      <p>
        多磨霊園には、文学・政治・芸術など、さまざまな分野で足跡を残した人々が眠っています。名前から墓所を探せます。
      </p>
    </article>
  </Fragment>

  <div class="article">
    <section aria-labelledby="famous-list-heading">
      <h2 id="famous-list-heading">名前から探す</h2>
      <p>
        五十音（読みの頭文字）ごとに分けています。見出しを選ぶと、その範囲の一覧が開きます。
      </p>

      <div class="kana-accordion">
        {
          groups.map((group) => (
            <details class="kana-accordion__item">
              <summary class="kana-accordion__summary">
                <span class="kana-accordion__label">{group.kana}行</span>
                <span class="kana-accordion__count">{group.entries.length}人</span>
                <svg class="kana-accordion__chevron" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                  <path d="M5 7.5 L10 12.5 L15 7.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </summary>
              <div class="article__table-scroll" tabindex="0" role="region" aria-label={`「${group.kana}」の著名人墓所一覧の表（横スクロールできます）`}>
                <table>
                  <caption class="sr-only">「{group.kana}」から始まる著名人の墓所一覧</caption>
                  <thead>
                    <tr>
                      <th scope="col">氏名</th>
                      <th scope="col">主な分野</th>
                      <th scope="col">墓所の場所</th>
                    </tr>
                  </thead>
                  <tbody>
                    {group.entries.map((entry) => (
                      <tr>
                        <th scope="row">{entry.name.replace(new RegExp('　', 'g'), ' ')}</th>
                        <td>{entry.career}</td>
                        <td>{formatPlot(entry)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="famous-howto-heading">
      <h2 id="famous-howto-heading">墓所の探し方</h2>
      <p>
        上の一覧にある「区・種・側・番」は、墓所の場所を表す公式の住所のようなものです。控えてから、次のいずれかの方法で場所を確認できます。
      </p>
      <ul>
        <li>
          <a
            href={GUIDE_SOURCES.tamaHakaNavi.url}
            rel="noopener"
            target="_blank"
            data-event="official_procedure_click"
            data-authority="tokyo_park_association"
            data-topic="famous_graves_haka_navi_howto">公式墓所ナビ</a
          >で「区・種・側・番」を入力すると、園内の地図上で位置を確認できます。
        </li>
        <li>
          下記の公式園内案内図（PDF）でも、区の位置関係を確認できます。園内の案内所（正門を入ってすぐ右側の管理事務所）でも紙の案内図を確認できます。
        </li>
      </ul>
    </section>

    <section aria-labelledby="famous-manner-heading">
      <h2 id="famous-manner-heading">墓参時の注意</h2>
      <div class="article__callout article__callout--warm">
        <p class="article__callout__eyebrow">お出かけ前に</p>
        <p>
          東京都公園協会の公式ページでは、霊園を訪れる際のマナーとして次のような点が案内されています。
        </p>
        <ul>
          <li>霊園は慰霊の場所であり、節度をもって静かに散策すること。</li>
          <li>許可なく他人の墓所に立ち入らないこと。</li>
          <li>園内道路を横断するときは、車に注意すること（一般車両も通行します）。</li>
          <li>ごみは持ち帰り、草花や生き物を採ったり、生き物にえさを与えたりしないこと。</li>
          <li>貴重品の管理など、防犯にも注意すること。</li>
        </ul>
        <p>
          また、一部の墓所はご遺族の意向により公式案内図に掲載されていないことも、公式ページで案内されています。掲載されている場合でも、個人のお墓であることに変わりはないため、静かに見学しましょう。
        </p>
      </div>
    </section>

    <section aria-labelledby="famous-map-heading">
      <h2 id="famous-map-heading">公式案内図</h2>
      <div class="article__button-row">
        <a
          class="article__button"
          href={GUIDE_SOURCES.tamaMapPdf.url}
          rel="noopener"
          target="_blank"
          data-event="official_procedure_click"
          data-authority="tokyo_park_association"
          data-topic="famous_graves_map_pdf">公式園内案内図を開く（PDF）</a
        >
        <a
          class="article__button article__button--secondary"
          href={GUIDE_SOURCES.tamaHakaNavi.url}
          rel="noopener"
          target="_blank"
          data-event="official_procedure_click"
          data-authority="tokyo_park_association"
          data-topic="famous_graves_haka_navi">公式墓所ナビを開く</a
        >
      </div>
      <p class="article__note">地図・案内図はいずれも公式サイトへのリンクです。画像としての保存・転載はしていません。</p>
    </section>

    <section aria-labelledby="famous-sources-heading">
      <h2 id="famous-sources-heading">情報源・確認日</h2>
      <ul class="article__sources">
        <li>
          <a href={GUIDE_SOURCES.tamaMapPdf.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaMapPdf.publisher}「{GUIDE_SOURCES.tamaMapPdf.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaMapPdf.checkedAt}） — 著名人墓所一覧（氏名・主要経歴・区・種・側・番）の出典
        </li>
        <li>
          <a href={GUIDE_SOURCES.tamaHakaNavi.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaHakaNavi.publisher}「{GUIDE_SOURCES.tamaHakaNavi.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaHakaNavi.checkedAt}）
        </li>
        <li>
          <a href={GUIDE_SOURCES.tamaTourManner.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaTourManner.publisher}「{GUIDE_SOURCES.tamaTourManner.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaTourManner.checkedAt}） — 「墓参時の注意」の出典
        </li>
      </ul>
      <p><a href={ROUTES.about.path}>掲載してほしい情報・訂正のご連絡はこちら</a></p>
    </section>
  </div>

  <div class="article">
    <section aria-labelledby="famous-related-heading">
      <h2 id="famous-related-heading">関連ページ</h2>
      <ul class="article__related-grid">
        <li><a class="article__related-card" href={ROUTES.guideHistory.path}>多磨霊園の歴史を見る</a></li>
        <li><a class="article__related-card" href={ROUTES.access.path}>多磨霊園への行き方を見る</a></li>
        <li><a class="article__related-card" href={ROUTES.guide.path}>多磨霊園ガイド一覧を見る</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  /*
   * 「名前から探す」五十音アコーディオン（2026-09-02、ミチの編集改善・
   * SEO/AIO対応「著名人ページ」節）。
   *
   * <details>/<summary>のネイティブな開閉セマンティクスを維持したまま、
   * 次の要件を満たすCSSだけを追加する:
   * - 行全体がクリック/タップ可能（summaryをflexにして子要素はpointer-events
   *   を変更しない。中の要素をクリックしても親のsummaryクリックとして
   *   扱われるのがブラウザ標準の挙動）。
   * - PCではcursor:pointer、ホバー時は薄い緑地（--color-tint-green-bg）。
   * - 右端に開閉矢印（chevron）を置き、開いたときに180度回転させる
   *   （矢印の絵文字を差し替えるのではなく、transformで回転させることで
   *   「回転する」という指定に文字どおり対応する）。
   * - 最小高さ48px、フォーカス時に明確な輪郭を表示、キーボード操作は
   *   <summary>のネイティブな挙動でEnter/Spaceに対応済み。
   */
  .kana-accordion {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .kana-accordion__item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    overflow: hidden;
  }

  .kana-accordion__summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-text);
  }

  .kana-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .kana-accordion__summary::marker {
    content: '';
  }

  .kana-accordion__summary:hover {
    background: var(--color-tint-green-bg);
  }

  .kana-accordion__summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
  }

  .kana-accordion__label {
    font-family: var(--font-family-heading);
  }

  .kana-accordion__count {
    color: var(--color-text-muted);
    font-weight: 400;
    font-size: var(--font-size-label);
  }

  .kana-accordion__chevron {
    margin-left: auto;
    flex-shrink: 0;
    color: var(--color-text-muted);
    transition: transform 0.15s ease;
  }

  .kana-accordion__item[open] > .kana-accordion__summary .kana-accordion__chevron {
    transform: rotate(180deg);
  }

  .kana-accordion__item[open] > .kana-accordion__summary {
    border-bottom: 1px solid var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .kana-accordion__chevron {
      transition: none;
    }
  }
</style>
