---
/**
 * 多磨霊園はなぜ造られた？1923年開園からの歴史。
 * 正本: src/lib/routes.ts ROUTES.guideHistory（2026-08-27新設）。
 *
 * 出典: 東京都公園協会公式サイト（sources.csv既存レコード SRC-TAMA-OFFICIAL、
 * および src/pages/_lib/guide-sources.ts の tamaOverview）。
 * 開設年月日・面積・「日本初の公園墓地」「ドイツの森林墓地を参考」は
 * 公式ページの記載を要約したもの（本文の転載はしていない）。
 * 「都立霊園の中で最大規模」「区画は26区」は、2026-08-27時点では東京都
 * 公園協会の公式ページ本文に数値としての明記が見当たらなかったため、
 * Wikipedia「多磨霊園」記事で補強確認した参考情報として別掲していた。
 *
 * 出典の格上げ（2026-09-01、ミチの全体校正・著名人墓所ページ実装時に
 * 副次的に確認）: 著名人墓所データの取得のためGUIDE_SOURCES.tamaMapPdf
 * （公式園内案内図PDF）をPyMuPDFで直接読み取った際、同PDF本文に
 * 「現在は約128万㎡（およそ39万坪）と都立8霊園のなかで最も広い面積を
 * 有しています」「墓域は園路によって26区の区域に分けられ」という記載を
 * 直接確認できた。これにより、この2点は公式一次資料で裏付けが取れたため、
 * Wikipedia参考情報からGUIDE_SOURCES.tamaMapPdfの直接引用へ格上げした
 * （Wikipediaを行政・霊園情報の根拠にしないという方針にも合致する）。
 *
 * スポンサー分散レイアウト対応（2026-09-01、ミチの全体校正・指摘3対応）:
 * 本文を3つに分け、BaseLayout.astroの`articleIntro`／既定／`articleTail`
 * スロットへ渡すようにした（詳細はsrc/layouts/BaseLayout.astro該当コメント
 * 参照）。articleIntro=「なぜ新しい墓地が必要だったのか」（最初の内容
 * ブロック）、既定スロット=「日本で最初の『公園墓地』」〜「情報源」、
 * articleTail=「関連ページ」。
 *
 * モバイル最優先レビュー対応（2026-09-01）: 導入直後に要点カード
 * （開設日・面積・区数・名称変更年）を追加し、関連ページをカード化した。
 * 写真（hero-cemetery-v1.png、既存プロジェクト内画像を別クロップで再利用。
 * 新規取得はしていない）を導入部に追加した。見出し・本文の事実関係は
 * 上記の出典格上げ箇所を除き変更していない。
 */
import '../../../styles/guide-article.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { ROUTES } from '../../../lib/routes';
import { getSourceById } from '../../../lib/data';
import { GUIDE_SOURCES } from '../../_lib/guide-sources';
import { buildArticleJsonLd } from '../../../lib/seo';

const historyFacts = [
  { label: '開設', value: '1923年4月1日' },
  { label: '面積', value: '約128万㎡' },
  { label: '区画', value: '全26区' },
  { label: '改名', value: '1935年' },
] as const;

const pageTitle = '多磨霊園はなぜ造られた？1923年開園からの歴史';
const description =
  '多磨霊園がなぜ、どのように造られたのかを、東京都公園協会の公式情報をもとに要約しました。開設の背景、日本初の公園墓地としての位置づけ、名称の変遷を紹介します。';
const browserTitle = `${pageTitle}｜多磨霊園 お墓ガイド`;

const tamaOfficial = getSourceById('SRC-TAMA-OFFICIAL');
// 更新日・出典表記の簡略化（2026-09-02、ミチの編集改善・SEO/AIO対応
// 「更新日・出典」節）: 記事冒頭は「更新日：YYYY年M月D日」だけを表示し、
// 出典一覧は記事末尾の「情報源」節へ一本化する（本文中の重要な数値には
// 別途インラインの出典リンクを残す。下記history-scale-heading参照）。
// 2026-09-02、「現在の規模」段落へインライン出典リンクを追加する本文修正を
// 行ったため、更新日を2026年9月2日に更新した（ビルド日時での自動更新では
// なく、実際の本文変更に伴う更新）。
const checkedAtJa = '2026年9月2日';

const articleJsonLd = buildArticleJsonLd({
  path: ROUTES.guideHistory.path,
  headline: pageTitle,
  description,
  datePublished: '2026-08-27',
  dateModified: '2026-09-02',
  image: '/images/hero-cemetery-v1.png',
});
---

<BaseLayout title={browserTitle} description={description} ogType="article" extraJsonLd={[articleJsonLd]}>
  <Fragment slot="beforeSponsor">
    <article class="article">
      <p class="article__eyebrow"><a href={ROUTES.guide.path}>多磨霊園ガイド</a> ／ 多磨霊園の歴史・著名人</p>
      <h1>{pageTitle}</h1>
      <p class="article__meta">更新日：{checkedAtJa}</p>

      <div class="article__hero-photo" style="background-image:url('/images/hero-cemetery-v1.png')"></div>
      <p class="article__hero-photo__credit">イメージ写真</p>

      <section aria-labelledby="history-background-heading">
        <h2 id="history-background-heading">なぜ新しい墓地が必要だったのか</h2>
        <p>
          明治から大正にかけて東京市街地は急激に発展し、それまであった市内の墓地の多くが使用許可済みとなっていました。新しい墓地用地を郊外に確保する必要から計画されたのが多磨霊園です。1923年（大正12年）4月1日に開設され、当初は「多磨墓地」という名称でした。
        </p>
        <ul class="article__facts">
          {
            historyFacts.map((fact) => (
              <li>
                <p class="article__facts-label">{fact.label}</p>
                <p class="article__facts-value">{fact.value}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </Fragment>

  <div class="article">
    <section aria-labelledby="history-parkcemetery-heading">
      <h2 id="history-parkcemetery-heading">日本で最初の「公園墓地」</h2>
      <p>
        多磨霊園は、公式サイト上で「我が国初めての公園墓地」と紹介されています。墓石が並ぶだけの従来型の墓地ではなく、樹木や園路を配した公園のような環境をめざして計画された点が特徴です。設計にあたっては、ドイツの森林墓地が参考にされたとされています。
      </p>
    </section>

    <section aria-labelledby="history-rename-heading">
      <h2 id="history-rename-heading">「多磨墓地」から「多磨霊園」へ</h2>
      <p>
        1935年（昭和10年）、千葉県松戸市にまたがる八柱霊園の開設を機に、名称が「多磨霊園」へと改められました。現在の正式名称は「多磨霊園」であり、「多摩霊園」という表記は誤りです。
      </p>
    </section>

    <section aria-labelledby="history-scale-heading">
      <h2 id="history-scale-heading">現在の規模</h2>
      <p>
        公式サイトによれば、開園面積は1,280,237平方メートル（約128ヘクタール）です。
        <a href={GUIDE_SOURCES.tamaMapPdf.url} rel="noopener" target="_blank">
          公式の園内案内図（{GUIDE_SOURCES.tamaMapPdf.publisher}）
        </a>
        には「都立8霊園のなかで最も広い面積を有しています」と明記されており、墓域は園路によって1区から26区までの「区」に分けられています。
      </p>
    </section>

    <section aria-labelledby="history-sources-heading">
      <h2 id="history-sources-heading">情報源</h2>
      <ul class="article__sources">
        {
          tamaOfficial && (
            <li>
              <a href={tamaOfficial.url} rel="noopener" target="_blank">
                {tamaOfficial.publisher}「{tamaOfficial.title}」
              </a>
              （最終確認日: {tamaOfficial.checked_at}） — 開設日、面積、日本初の公園墓地、ドイツの森林墓地を参考にした旨の記載元
            </li>
          )
        }
        <li>
          <a href={GUIDE_SOURCES.tamaOverview.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaOverview.publisher}「{GUIDE_SOURCES.tamaOverview.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaOverview.checkedAt}） — 開設の背景、名称変更の経緯の記載元
        </li>
        <li>
          <a href={GUIDE_SOURCES.tamaMapPdf.url} rel="noopener" target="_blank">
            {GUIDE_SOURCES.tamaMapPdf.publisher}「{GUIDE_SOURCES.tamaMapPdf.title}」
          </a>
          （最終確認日: {GUIDE_SOURCES.tamaMapPdf.checkedAt}） — 「都立8霊園のなかで最も広い面積」「26区」の記載元
        </li>
      </ul>
      <p><a href={ROUTES.about.path}>誤りに気づいた場合の訂正窓口はこちら</a></p>
    </section>
  </div>

  <div class="article">
    <section aria-labelledby="history-related-heading">
      <h2 id="history-related-heading">関連ページ</h2>
      <ul class="article__related-grid">
        <li><a class="article__related-card article__related-card--limestone" href={ROUTES.guideFamousGraves.path}>多磨霊園に眠る著名人ガイドを見る</a></li>
        <li><a class="article__related-card article__related-card--limestone" href={ROUTES.access.path}>多磨霊園への行き方を見る</a></li>
        <li><a class="article__related-card article__related-card--limestone" href={ROUTES.guide.path}>多磨霊園ガイド一覧を見る</a></li>
      </ul>
    </section>
  </div>
</BaseLayout>
