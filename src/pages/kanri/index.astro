---
/**
 * 墓所管理・清掃・供花の比較。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章 / src/lib/routes.ts ROUTES.kanri
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../lib/routes';
import { getBusinesses } from '../../lib/data';
import ComparisonTable from '../../components/business/ComparisonTable.astro';
import BusinessContactList from '../_partials/BusinessContactList.astro';
import PriceList from '../_partials/PriceList.astro';
import CorrectionCta from '../../components/common/CorrectionCta.astro';

const businesses = getBusinesses();
const serviceKeys = ['annual_management', 'cleaning', 'flowers', 'planting'] as const;
const pageTitle = '墓所管理・清掃・供花の比較';
const description =
  '年間管理、清掃、供花・墓参り代行、植木の対応状況を、公開情報のみで事業者ごとに比較します。';
---

<BaseLayout title={pageTitle} description={description}>
  <h1>{pageTitle}</h1>
  <p>
    遠方にお住まいの方向けに、年間を通じた墓所管理・清掃・供花・植木の対応状況を比較しています。「遠方対応・写真報告」の対応状況もあわせてご確認ください。
  </p>

  <section aria-labelledby="kanri-comparison-heading">
    <h2 id="kanri-comparison-heading">対応状況の比較</h2>
    <ComparisonTable
      businesses={businesses}
      visibleServices={[...serviceKeys, 'remote_photo_report']}
    />
  </section>

  <section aria-labelledby="kanri-contact-heading">
    <h2 id="kanri-contact-heading">連絡先・アクセス</h2>
    <BusinessContactList businesses={businesses} caption="墓所管理・清掃・供花の連絡先一覧" />
  </section>

  <section aria-labelledby="kanri-price-heading">
    <h2 id="kanri-price-heading">価格の目安</h2>
    <p>
      公開ページ上に金額の記載がある場合のみ、以下に「◯円〜」の形式で表示します。回数・訪問頻度・墓所の広さ等の条件により変動する場合があります。
    </p>
    <PriceList businesses={businesses} serviceKeys={[...serviceKeys]} />
  </section>

  <CorrectionCta />

  <section aria-labelledby="kanri-links-heading">
    <h2 id="kanri-links-heading">関連ページ</h2>
    <ul>
      <li><a href={ROUTES.sekizaiten.path}>14社の一覧・比較表を見る</a></li>
      <li><a href={ROUTES.hakajimai.path}>墓じまい・墓石撤去の比較を見る</a></li>
    </ul>
  </section>
</BaseLayout>
