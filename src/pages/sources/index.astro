---
/**
 * 情報源・最終確認日。
 * 正本: CLAUDE_CODE_HANDOFF.md 5章 / src/lib/routes.ts ROUTES.sources
 *
 * QA監査（2026-08-27、feature/content-guide-and-sponsored-results）対応:
 * このページは元々sources.csv（事業者比較データの出典）だけを一覧していたが、
 * /guide/**・/access/ 等のガイド記事が使う出典（東京都公園協会の公式ページ、
 * 園内案内図PDF、公式墓所ナビ等、src/pages/_lib/guide-sources.tsで定義）が
 * 一覧されておらず、情報源ページとして不完全という指摘を受けた。
 * sources.csv（正本、内容を変更しない）はそのまま維持しつつ、
 * ガイド記事の出典は別セクションとして追加する（各記事本文の「情報源」欄にも
 * 個別掲載済みだが、この一覧ページからも横断的に確認できるようにする）。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ROUTES } from '../../lib/routes';
import { getBusinesses, getSources, getSourceById } from '../../lib/data';
import { GUIDE_SOURCES } from '../_lib/guide-sources';

const sources = getSources();
const businesses = getBusinesses();
const businessNameById = new Map(businesses.map((b) => [b.id, b.name]));

const tamaOfficial = getSourceById('SRC-TAMA-OFFICIAL');
const tamaWorkNotice = getSourceById('SRC-TAMA-WORK-NOTICE');
const fuchuReburial = getSourceById('SRC-FUCHU-REBURIAL');

/** ガイド記事の出典一覧（sources.csvと重複しないもの）。 */
const guideSourceList = [
  { ...GUIDE_SOURCES.tamaOverview, usedIn: '多磨霊園の歴史' },
  { ...GUIDE_SOURCES.tamaMapPdf, usedIn: '多磨霊園への行き方／著名人墓所ガイド' },
  { ...GUIDE_SOURCES.tamaHakaNavi, usedIn: '多磨霊園への行き方／著名人墓所ガイド' },
  { ...GUIDE_SOURCES.googleMapsTama, usedIn: '多磨霊園への行き方' },
];

const pageTitle = '情報源・最終確認日';
const description = '掲載情報の出典（公式サイト・行政ページ等）と、それぞれの最終確認日の一覧です。';
const browserTitle = `${pageTitle}｜多磨霊園 お墓ガイド`;
---

<BaseLayout title={browserTitle} description={description}>
  <h1>{pageTitle}</h1>
  <p>
    当サイトに掲載している情報は、以下の出典（事業者の公式サイト、行政の公式ページ、商工会等の名簿）をもとにしています。住所・電話・料金・制度は90日ごと、行政制度は30日ごとまたは公開直前を目安に再確認しています。リンク切れに気づいた場合は<a
      href={ROUTES.about.path}>運営方針ページ</a
    >の訂正窓口までお知らせください。
  </p>

  <div class="sources-table__scroll">
    <table>
      <caption>情報源一覧（{sources.length}件）</caption>
      <thead>
        <tr>
          <th scope="col">対象事業者</th>
          <th scope="col">発行者</th>
          <th scope="col">タイトル</th>
          <th scope="col">種別</th>
          <th scope="col">最終確認日</th>
          <th scope="col">リンク</th>
        </tr>
      </thead>
      <tbody>
        {
          sources.map((source) => (
            <tr>
              <td>{source.business_id ? businessNameById.get(source.business_id) || source.business_id : '共通（施設・行政情報）'}</td>
              <td>{source.publisher}</td>
              <td>{source.title}</td>
              <td>{source.source_type}</td>
              <td>{source.checked_at}</td>
              <td>
                <a href={source.url} rel="noopener" target="_blank">
                  出典ページを開く
                </a>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <section aria-labelledby="guide-sources-heading">
    <h2 id="guide-sources-heading">多磨霊園ガイド記事の情報源</h2>
    <p>
      <a href={ROUTES.guide.path}>多磨霊園ガイド</a>（行き方・歴史・著名人墓所等）で使用している出典です。事業者比較データとは別に、東京都公園協会の公式ページ・案内図・墓所ナビを直接参照しています。
    </p>
    <div class="sources-table__scroll">
      <table>
        <caption>ガイド記事の情報源一覧（{guideSourceList.length + (tamaOfficial ? 1 : 0) + (tamaWorkNotice ? 1 : 0) + (fuchuReburial ? 1 : 0)}件）</caption>
        <thead>
          <tr>
            <th scope="col">発行者</th>
            <th scope="col">タイトル</th>
            <th scope="col">使用記事</th>
            <th scope="col">最終確認日</th>
            <th scope="col">リンク</th>
          </tr>
        </thead>
        <tbody>
          {
            tamaOfficial && (
              <tr>
                <td>{tamaOfficial.publisher}</td>
                <td>{tamaOfficial.title}</td>
                <td>多磨霊園への行き方／歴史</td>
                <td>{tamaOfficial.checked_at}</td>
                <td>
                  <a href={tamaOfficial.url} rel="noopener" target="_blank">
                    出典ページを開く
                  </a>
                </td>
              </tr>
            )
          }
          {
            tamaWorkNotice && (
              <tr>
                <td>{tamaWorkNotice.publisher}</td>
                <td>{tamaWorkNotice.title}</td>
                <td>墓じまいと改葬の違い</td>
                <td>{tamaWorkNotice.checked_at}</td>
                <td>
                  <a href={tamaWorkNotice.url} rel="noopener" target="_blank">
                    出典ページを開く
                  </a>
                </td>
              </tr>
            )
          }
          {
            fuchuReburial && (
              <tr>
                <td>{fuchuReburial.publisher}</td>
                <td>{fuchuReburial.title}</td>
                <td>墓じまいと改葬の違い</td>
                <td>{fuchuReburial.checked_at}</td>
                <td>
                  <a href={fuchuReburial.url} rel="noopener" target="_blank">
                    出典ページを開く
                  </a>
                </td>
              </tr>
            )
          }
          {
            guideSourceList.map((source) => (
              <tr>
                <td>{source.publisher}</td>
                <td>{source.title}</td>
                <td>{source.usedIn}</td>
                <td>{source.checkedAt}</td>
                <td>
                  <a href={source.url} rel="noopener" target="_blank">
                    出典ページを開く
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>
</BaseLayout>

<style>
  .sources-table__scroll {
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    min-width: 640px;
  }
  caption {
    text-align: left;
    font-weight: 700;
    margin-bottom: var(--space-2, 0.5rem);
  }
  th,
  td {
    border: 1px solid var(--color-border, #dcdcd4);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    text-align: left;
    vertical-align: top;
  }
  thead th {
    background: var(--color-accent-soft, #e7ede8);
  }
</style>
