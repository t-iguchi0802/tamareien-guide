---
/**
 * 電話発信リンク。
 *
 * 電話番号が未確認の場合は呼び出し側（BusinessCard等）でこのコンポーネント自体を
 * 描画しない（PhoneLinkPropsのコメント参照）。ここでは受け取ったphoneを
 * そのままtel:リンク化する（桁の推測補正は行わない）。
 */
import '../../styles/tokens.css';
import type { PhoneLinkProps } from '../../types/components';

type Props = PhoneLinkProps;
const { businessId, businessName, phone } = Astro.props;

const telHref = `tel:${phone.replace(/[^0-9+]/g, '')}`;
const pagePath = Astro.url.pathname;
---

<a
  class="phone-link"
  data-event="business_phone_click"
  data-business-id={businessId}
  data-business-name={businessName}
  data-page-path={pagePath}
  href={telHref}
>
  <svg class="phone-link__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M3.5 2.5c.6-.4 1.6-.6 2 0l1 1.6c.3.5.2 1.1-.2 1.5l-.8.8c.5 1.2 1.5 2.2 2.7 2.7l.8-.8c.4-.4 1-.5 1.5-.2l1.6 1c.6.4.4 1.4 0 2-.9 1.3-2.6 1.6-4 .9-2.4-1.1-4.4-3.1-5.5-5.5-.7-1.4-.4-3.1.9-4z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
  </svg>
  <span class="phone-link__label">電話 {phone}</span>
</a>

<style>
  .phone-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--tap-target-min);
    padding: 0.6em 1.1em;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-accent);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1.5px solid var(--color-accent);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  .phone-link:hover {
    background: var(--color-accent-soft);
  }

  .phone-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .phone-link__icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
