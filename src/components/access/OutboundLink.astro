---
/**
 * 事業者への外部リンクCTA（公式サイト・問い合わせページ・第三者掲載ページ）。
 *
 * GA4計測は seo-analytics 担当が別途実装するため、ここでは計測フックとして
 * 安定した data-* 属性を生やすところまでを担当する
 * （イベント名・パラメータ名は src/types/analytics.ts の契約に合わせてある）。
 */
import '../../styles/tokens.css';
import type { OutboundLinkProps } from '../../types/components';

type Props = OutboundLinkProps;
const { businessId, linkType, href, label } = Astro.props;

const defaultLabelByType: Record<OutboundLinkProps['linkType'], string> = {
  official_site: '公式サイトを見る',
  contact: '問い合わせページを見る',
  directory: '掲載ページを見る',
};

const displayLabel = label ?? defaultLabelByType[linkType];
const pagePath = Astro.url.pathname;
---

<a
  class="outbound-link"
  data-outbound-link
  data-event="business_outbound_click"
  data-business-id={businessId}
  data-link-type={linkType}
  data-page-path={pagePath}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <span class="outbound-link__label">{displayLabel}</span>
  <svg class="outbound-link__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M6 3.5h6.5V10M12.2 3.8L3.5 12.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  </svg>
  <span class="sr-only">（外部サイトを新しいタブで開きます）</span>
</a>

<style>
  .outbound-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--tap-target-min);
    padding: 0.6em 1.25em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-surface);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1px solid var(--color-accent);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .outbound-link:hover {
    background: var(--color-accent-deep);
    border-color: var(--color-accent-deep);
  }

  .outbound-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .outbound-link__icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
