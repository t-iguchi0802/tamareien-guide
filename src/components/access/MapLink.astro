---
/**
 * 地図リンク（地図検索・地図アプリ等へのリンク）。
 * href生成（住所からのURL組み立て等）は呼び出し側の責務とし、
 * ここでは受け取ったhrefをそのまま使う。
 */
import '../../styles/tokens.css';
import type { MapLinkProps } from '../../types/components';

type Props = MapLinkProps;
const { businessId, href, label } = Astro.props;
const displayLabel = label ?? '地図で見る';
const pagePath = Astro.url.pathname;
---

<a
  class="map-link"
  data-event="business_map_click"
  data-business-id={businessId}
  data-page-path={pagePath}
  href={href}
  target="_blank"
  rel="noopener noreferrer"
>
  <svg class="map-link__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
    <path
      d="M8 1.5c-2.2 0-4 1.8-4 4 0 3 4 8.5 4 8.5s4-5.5 4-8.5c0-2.2-1.8-4-4-4z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linejoin="round"></path>
    <circle cx="8" cy="5.5" r="1.4" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
  </svg>
  <span class="map-link__label">{displayLabel}</span>
  <span class="sr-only">（外部地図サイトを新しいタブで開きます）</span>
</a>

<style>
  .map-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    min-height: var(--tap-target-min);
    padding: 0.6em 1.1em;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-stone-text);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 1.5px solid var(--color-stone-line);
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .map-link:hover {
    background: var(--color-bg);
    border-color: var(--color-stone-text);
  }

  .map-link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .map-link__icon {
    width: 1em;
    height: 1em;
    flex: none;
  }
</style>
