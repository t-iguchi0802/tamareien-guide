---
/**
 * 事業者カード（一覧・比較表で使用）。
 *
 * 表示方針:
 * - listingTier（A/B）は品質評価ではない社内管理値のため画面には出さない
 *   （data_dictionary.md 3章）。displayOrderも同様に非表示（推奨順位ではない）。
 * - 星評価・独自ランキング・「おすすめ」等は一切追加しない。
 * - 対応サービスのタグは「事業者が公開情報で確認できる対応」の事実列挙であり、
 *   件数の多寡で優劣を主張する意図では使わない（並び順は serviceKeys の定義順）。
 * - 電話が未確認の場合はPhoneLinkを描画せず、「公開情報では未確認」の文言で示す
 *   （data_dictionary.md 5章）。
 * - 地図リンクは、確認済みの住所文字列から検索クエリを組み立てる
 *   （座標・徒歩分数等の独自推定は行わない）。
 *
 * editorial-redesign（2026-08-26）での変更点:
 * - 「公開情報で確認できる対応」という説明見出しと、確認済みサービスを
 *   すべて緑枠タグとして並べる表現をやめた。代わりに、対応状況を1本の
 *   文章（読点区切り）として、名前・所在地の直後（要約文より前）に置く。
 *   タグの壁ではなく、地の文として読める形にする。
 * - 各サービス名を`data-service-word`付きの<span>として個別にマークし、
 *   `ServiceFilter.astro`のスクリプトが、選択中の条件と一致する語だけを
 *   実行時に太字・深緑にする（どの条件で絞り込まれたかはビルド時にはまだ
 *   決まらないため、ハイライトはクライアント側で行う）。フィルタ未使用の
 *   ページ・JS無効時でも、全確認済みサービスが淡い地の文として読める。
 * - `data-service-keys`（カンマ区切り）を要素に持たせ、フィルタスクリプトが
 *   AND条件の一致判定に使う。ここでの判定ロジック自体は持たない
 *   （表示コンポーネントとしての責務にとどめる）。
 *
 * スポンサー契約店は、利用者が1つ以上のサービス条件を選び、その条件に
 * 一致した場合だけ「PR」を表示する。未選択時はバッジを
 * 隠し、通常掲載順へ影響させない。
 *
 * カード内容の段階表示（2026-09-01、ミチのモバイル優先UI・文章校正対応
 * 「石材店一覧のスマートフォン表示」節）: 390px幅でカードが縦に長く
 * （旧14社時点でも約13,228px相当）、店ごとの差を比較しにくい状態だったため、
 * データを削除せず初期表示だけを絞った。
 * - 初期表示: 店名／所在地域／選択条件と一致した項目（該当時のみ）／
 *   確認できた主な対応（最大3件、残りは件数だけ表示）／電話／公式サイト
 *   （副導線として地図も表示、問い合わせページは詳細側）。
 * - `<details>`（JS不使用、ネイティブ開閉）「詳しい対応内容を見る」に、
 *   残りの確認済みサービス全件・紹介文（4行までクランプ）・資格や特徴・
 *   創業年・問い合わせページを格納する。
 * - 「選択条件と一致した項目」ブロック（`data-match-block`）は、
 *   ServiceFilter.astroのJSが「1つ以上の条件が選択され、かつこの事業者が
 *   全条件を満たす」場合だけ`hidden`を外し、一致した語（selected配下の
 *   `[data-service-word]`のテキストをそのまま複製、SERVICE_LABELSの
 *   二重管理をしない）を`data-match-list`へ書き込む。スポンサー限定の
 *   `.business-card__sponsor-badge`とは別物（一致すれば全事業者に出る）。
 * - not_confirmedの扱い・データ自体は一切変更していない
 *   （「詳しい対応内容を見る」に移動しただけで、削除・「非対応」化はしていない）。
 */
import '../../styles/tokens.css';
import type { BusinessCardProps } from '../../types/components';
import type { ServiceKey } from '../../types/business';
import OutboundLink from '../access/OutboundLink.astro';
import PhoneLink from '../access/PhoneLink.astro';
import MapLink from '../access/MapLink.astro';
import { SERVICE_LABELS } from './serviceLabels';

type Props = BusinessCardProps;
const { business, isSponsored = false } = Astro.props;

const UNCONFIRMED_TEXT = '公開情報では未確認';
const confirmedServiceKeys = (Object.keys(SERVICE_LABELS) as ServiceKey[]).filter(
  (key) => business.services[key] === 'confirmed',
);
const addressText = [
  business.location.prefecture,
  business.location.city,
  business.location.addressLine,
]
  .filter(Boolean)
  .join('');
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${business.name} ${addressText}`,
)}`;

const primaryOutbound = business.contact.websiteUrl
  ? {
      href: business.contact.websiteUrl,
      linkType: 'official_site' as const,
      label: '公式サイトを見る',
    }
  : business.contact.directoryUrl
    ? {
        href: business.contact.directoryUrl,
        linkType: 'directory' as const,
        label: '掲載ページを見る',
      }
    : null;

---

<article
  id={`business-${business.id}`}
  class="business-card"
  data-business-id={business.id}
  data-business-name={business.name}
  data-business-city={business.location.city}
  data-business-order={business.displayOrder}
  data-sponsored={String(isSponsored)}
  data-service-keys={confirmedServiceKeys.join(',')}
>
  <header class="business-card__header">
    <p class="business-card__sponsor-badge" data-sponsor-result-badge hidden>PR｜メインスポンサー</p>
    <h3 class="business-card__name">{business.name}</h3>
    <p class="business-card__meta">
      {business.location.city}
      {
        business.location.nearestGateStatus === 'confirmed' && business.location.nearestGate && (
          <>・{business.location.nearestGate}</>
        )
      }
    </p>
  </header>

  <div class="business-card__match" data-match-block hidden>
    <p class="business-card__match-label">選択条件と一致</p>
    <p class="business-card__match-list" data-match-list></p>
  </div>

  {
    confirmedServiceKeys.length > 0 ? (
      <div class="business-card__services-block">
        <p class="business-card__services-label">対応サービス</p>
        <p class="business-card__services">
          {confirmedServiceKeys.map((key, i) => (
            <>
              {i > 0 && '、'}
              <span class="service-word" data-service-word={key}>
                {SERVICE_LABELS[key]}
              </span>
            </>
          ))}
        </p>
      </div>
    ) : (
      <p class="business-card__services business-card__services--none">
        公開ページ上で対応を確認できたサービスは、現時点でありません（掲載情報は随時更新します）。
      </p>
    )
  }

  <p class="business-card__summary">{business.summary}</p>

  <div class="business-card__contact-row">
    {
      business.contact.phone ? (
        <PhoneLink
          businessId={business.id}
          businessName={business.name}
          phone={business.contact.phone}
        />
      ) : (
        <p class="business-card__unconfirmed-note">電話番号: {UNCONFIRMED_TEXT}</p>
      )
    }
  </div>

  <footer class="business-card__cta-row">
    {
      primaryOutbound && (
        <OutboundLink
          businessId={business.id}
          businessName={business.name}
          linkType={primaryOutbound.linkType}
          href={primaryOutbound.href}
          label={primaryOutbound.label}
        />
      )
    }
    <span class="business-card__secondary-cta">
      <MapLink businessId={business.id} businessName={business.name} href={mapHref} />
    </span>
  </footer>

</article>

<style>
  .business-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px double var(--color-stone-line);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  /*
   * ServiceFilter.astroが絞り込み非該当のカードに`hidden`属性を付与するが、
   * `.business-card { display: flex }`（Astroのスコープ用属性セレクタが付くため
   * 詳細度がブラウザ既定の`[hidden] { display: none }`と同格になる）が
   * それを上書きしてしまい、非表示のはずのカードが表示され続ける不具合が
   * あったため、明示的に上書きする。
   */
  .business-card[hidden] {
    display: none;
  }

  .business-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .business-card__sponsor-badge {
    width: fit-content;
    margin: 0 0 var(--space-1);
    padding: 0.25em 0.7em;
    border: 1px solid var(--color-sponsor-border);
    border-radius: var(--radius-pill);
    background: var(--color-sponsor-bg);
    color: var(--color-sponsor-fg);
    font-size: var(--font-size-caption);
    font-weight: 700;
  }

  .business-card__sponsor-badge[hidden] {
    display: none;
  }

  .business-card__name {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: var(--font-size-card-title);
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .business-card__meta {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  /* 選択条件と一致した項目（2026-09-01追加）。ServiceFilter.astroのJSが
     hidden属性とdata-match-listの中身を切り替える。既定では非表示。
     スポンサーバッジ（金色系）とは別系統の緑を使い、「広告」ではなく
     「あなたの条件に合っている」ことを示す。 */
  .business-card__match {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-card, 10px);
    background: var(--color-tint-green-bg);
    border: 1px solid var(--color-tint-green-border);
  }

  .business-card__match[hidden] {
    display: none;
  }

  .business-card__match-label {
    margin: 0 0 0.2em;
    font-size: var(--font-size-caption);
    font-weight: 700;
    color: var(--color-accent-deep);
  }

  .business-card__match-list {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-label);
  }

  .business-card__services-block {
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }

  .business-card__services-label {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-caption);
    font-weight: 700;
  }

  .business-card__services {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
    line-height: 1.7;
  }

  .business-card__services--none {
    font-style: normal;
  }

  .business-card__services-more {
    color: var(--color-text-muted);
  }

  [data-service-prefix] {
    color: var(--color-text-muted);
  }

  .service-word {
    color: var(--color-stone-text);
  }

  /* ServiceFilter.astroのスクリプトが、選択中の条件と一致する語にだけ付与する。
     太字と深緑への文字色変化に加え、モバイル最優先レビュー対応（2026-09-01）
     として、色だけに頼らず「チェックマーク＋ごく薄い緑地」でも一致を示す
     （色覚特性に配慮し、色以外の手がかりを持たせる）。タグの壁にならないよう、
     地の文の中に収まる控えめなインライン装飾にとどめる。 */
  .service-word--matched {
    color: var(--color-accent-deep);
    font-weight: 700;
    background: var(--color-tint-green-bg);
    border-radius: var(--radius-tag, 6px);
    padding: 0.05em 0.4em;
  }

  .service-word--matched::before {
    content: '✓ ';
  }

  .business-card__summary {
    margin: 0;
    color: var(--color-text);
    /* 「紹介文はスマホでは3〜4行まで」対応。詳細側（<details>展開後）でも、
       極端に長い紹介文でカードが際限なく伸びないよう4行にクランプする。
       line-clampは主要ブラウザで広くサポートされている。 */
    display: -webkit-box;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .business-card__credentials {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
  }

  .business-card__unconfirmed-note {
    margin: 0;
    color: var(--color-status-unconfirmed-fg);
    font-size: var(--font-size-label);
  }

  .business-card__contact-row {
    display: flex;
  }

  .business-card__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-stone-line-soft);
  }

  /* 電話・公式サイトを主導線、地図・問い合わせを副導線にする
     （2026-09-01）。副導線は文字だけの控えめなリンクにし、視覚的な重みを
     主導線（ボタン形状のOutboundLink/PhoneLink）より弱くする。 */
  .business-card__secondary-cta {
    display: inline-flex;
  }

  .business-card__secondary-cta :global(.outbound-link) {
    background: transparent;
    color: var(--color-accent);
    padding-inline: 0.3em;
  }

  .business-card__secondary-cta :global(.outbound-link:hover) {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
  }

  /* 「詳しい対応内容を見る」（2026-09-01追加）。ネイティブ<details>、
     JS不使用。開閉の目印はテキスト（▸/▾）で示し、タップ領域は
     var(--tap-target-min)を確保する。 */
  .business-card__detail {
    border-top: 1px solid var(--color-stone-line-soft);
    padding-top: var(--space-2);
  }

  .business-card__detail-summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-height: var(--tap-target-min);
    font-weight: 700;
    color: var(--color-accent);
  }

  .business-card__detail-summary::-webkit-details-marker {
    display: none;
  }

  .business-card__detail-summary::marker {
    content: '';
  }

  .business-card__detail-summary::before {
    content: '▸';
    color: var(--color-text-muted);
  }

  .business-card__detail[open] .business-card__detail-summary::before {
    content: '▾';
  }

  .business-card__detail-summary:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .business-card__detail-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  .business-card__detail-body .business-card__secondary-cta {
    display: inline-flex;
  }

  @media (max-width: 767px) {
    .business-card {
      gap: var(--space-2);
      padding: var(--space-4);
    }

    .business-card__cta-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-2);
    }
  }
</style>
