---
/**
 * 事業者カード（一覧・比較表で使用）。
 *
 * 表示方針:
 * - listingTier（A/B）は品質評価ではない社内管理値のため画面には出さない
 *   （data_dictionary.md 3章）。displayOrderも同様に非表示（推奨順位ではない）。
 * - 星評価・独自ランキング・「おすすめ」等は一切追加しない。
 * - 対応サービスのタグは「事業者が公開情報で確認できる対応」の事実列挙であり、
 *   件数の多寡で優劣を主張する意図では使わない（並び順は serviceKeys の定義順）。
 * - 電話が未確認の場合はPhoneLinkを描画せず、「公開情報では未確認」の文言で示す
 *   （data_dictionary.md 5章）。
 * - 地図リンクは、確認済みの住所文字列から検索クエリを組み立てる
 *   （座標・徒歩分数等の独自推定は行わない）。
 *
 * editorial-redesign（2026-08-26）での変更点:
 * - 「公開情報で確認できる対応」という説明見出しと、確認済みサービスを
 *   すべて緑枠タグとして並べる表現をやめた。代わりに、対応状況を1本の
 *   文章（読点区切り）として、名前・所在地の直後（要約文より前）に置く。
 *   タグの壁ではなく、地の文として読める形にする。
 * - 各サービス名を`data-service-word`付きの<span>として個別にマークし、
 *   `ServiceFilter.astro`のスクリプトが、選択中の条件と一致する語だけを
 *   実行時に太字・深緑にする（どの条件で絞り込まれたかはビルド時にはまだ
 *   決まらないため、ハイライトはクライアント側で行う）。フィルタ未使用の
 *   ページ・JS無効時でも、全確認済みサービスが淡い地の文として読める。
 * - `data-service-keys`（カンマ区切り）を要素に持たせ、フィルタスクリプトが
 *   AND条件の一致判定に使う。ここでの判定ロジック自体は持たない
 *   （表示コンポーネントとしての責務にとどめる）。
 */
import '../../styles/tokens.css';
import type { BusinessCardProps } from '../../types/components';
import type { ServiceKey } from '../../types/business';
import OutboundLink from '../access/OutboundLink.astro';
import PhoneLink from '../access/PhoneLink.astro';
import MapLink from '../access/MapLink.astro';
import { SERVICE_LABELS } from './serviceLabels';

type Props = BusinessCardProps;
const { business } = Astro.props;

const UNCONFIRMED_TEXT = '公開情報では未確認';

const confirmedServiceKeys = (Object.keys(SERVICE_LABELS) as ServiceKey[]).filter(
  (key) => business.services[key] === 'confirmed',
);

const addressText = [
  business.location.prefecture,
  business.location.city,
  business.location.addressLine,
]
  .filter(Boolean)
  .join('');
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${business.name} ${addressText}`,
)}`;

const primaryOutbound = business.contact.websiteUrl
  ? {
      href: business.contact.websiteUrl,
      linkType: 'official_site' as const,
      label: '公式サイトを見る',
    }
  : business.contact.directoryUrl
    ? {
        href: business.contact.directoryUrl,
        linkType: 'directory' as const,
        label: '掲載ページを見る',
      }
    : null;

const showSeparateContact =
  business.contact.contactUrl && business.contact.contactUrl !== business.contact.websiteUrl;
---

<article
  class="business-card"
  data-business-id={business.id}
  data-service-keys={confirmedServiceKeys.join(',')}
>
  <header class="business-card__header">
    <h3 class="business-card__name">{business.name}</h3>
    <p class="business-card__meta">
      {business.location.city}
      {
        business.location.nearestGateStatus === 'confirmed' && business.location.nearestGate && (
          <>・{business.location.nearestGate}</>
        )
      }
      {business.founded && <>・創業 {business.founded}</>}
    </p>
  </header>

  {
    confirmedServiceKeys.length > 0 ? (
      <p class="business-card__services">
        <span data-service-prefix>対応を確認できるサービス:</span>{' '}
        {confirmedServiceKeys.map((key, i) => (
          <>
            {i > 0 && '、'}
            <span class="service-word" data-service-word={key}>
              {SERVICE_LABELS[key]}
            </span>
          </>
        ))}
      </p>
    ) : (
      <p class="business-card__services business-card__services--none">
        公開ページ上で対応を確認できたサービスは、現時点でありません（掲載情報は随時更新します）。
      </p>
    )
  }

  <p class="business-card__summary">{business.summary}</p>

  {
    business.credentials.length > 0 && (
      <ul class="business-card__credentials">
        {business.credentials.map((credential) => (
          <li>{credential}</li>
        ))}
      </ul>
    )
  }

  <div class="business-card__contact-row">
    {
      business.contact.phone ? (
        <PhoneLink businessId={business.id} phone={business.contact.phone} />
      ) : (
        <p class="business-card__unconfirmed-note">電話番号: {UNCONFIRMED_TEXT}</p>
      )
    }
  </div>

  <footer class="business-card__cta-row">
    {
      primaryOutbound && (
        <OutboundLink
          businessId={business.id}
          linkType={primaryOutbound.linkType}
          href={primaryOutbound.href}
          label={primaryOutbound.label}
        />
      )
    }
    <MapLink businessId={business.id} href={mapHref} />
    {
      showSeparateContact && business.contact.contactUrl && (
        <span class="business-card__secondary-cta">
          <OutboundLink
            businessId={business.id}
            linkType="contact"
            href={business.contact.contactUrl}
            label="問い合わせページを見る"
          />
        </span>
      )
    }
  </footer>
</article>

<style>
  .business-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px double var(--color-stone-line);
    border-radius: var(--radius-card);
    padding: var(--space-6);
  }

  /*
   * ServiceFilter.astroが絞り込み非該当のカードに`hidden`属性を付与するが、
   * `.business-card { display: flex }`（Astroのスコープ用属性セレクタが付くため
   * 詳細度がブラウザ既定の`[hidden] { display: none }`と同格になる）が
   * それを上書きしてしまい、非表示のはずのカードが表示され続ける不具合が
   * あったため、明示的に上書きする。
   */
  .business-card[hidden] {
    display: none;
  }

  .business-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .business-card__name {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: var(--font-size-card-title);
    letter-spacing: 0.01em;
    color: var(--color-text);
  }

  .business-card__meta {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  .business-card__services {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
    line-height: 1.6;
  }

  .business-card__services--none {
    font-style: normal;
  }

  [data-service-prefix] {
    color: var(--color-text-muted);
  }

  .service-word {
    color: var(--color-stone-text);
  }

  /* ServiceFilter.astroのスクリプトが、選択中の条件と一致する語にだけ付与する。
     背景色・枠線は付けず、太字と深緑への文字色変化だけで示す
     （タグ／バッジ的なUI部品にしないため）。 */
  .service-word--matched {
    color: var(--color-accent-deep);
    font-weight: 700;
  }

  .business-card__summary {
    margin: 0;
    color: var(--color-text);
  }

  .business-card__credentials {
    margin: 0;
    padding-left: 1.2em;
    color: var(--color-text-muted);
    font-size: var(--font-size-label);
  }

  .business-card__unconfirmed-note {
    margin: 0;
    color: var(--color-status-unconfirmed-fg);
    font-size: var(--font-size-label);
  }

  .business-card__cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-stone-line-soft);
  }

  .business-card__secondary-cta :global(.outbound-link) {
    background: transparent;
    color: var(--color-accent);
  }

  .business-card__secondary-cta :global(.outbound-link:hover) {
    background: var(--color-accent-soft);
    border-color: var(--color-accent);
  }
</style>
