---
/**
 * 石材店一覧カード。
 *
 * 2026-10-03スマホ優先再設計:
 * - 一覧では店名・場所・確認済み対応項目・連絡導線だけを表示する。
 * - 紹介文、創業年、資格等は一覧の初期表示から外し、31社を比較しやすくする。
 * - 対応項目は元データを削らず、短い表示名にして列挙する。
 * - 選択中のフィルターに該当する項目はdata-service-wordで強調する。
 */
import '../../styles/tokens.css';
import type { BusinessCardProps } from '../../types/components';
import type { ServiceKey } from '../../types/business';
import OutboundLink from '../access/OutboundLink.astro';
import PhoneLink from '../access/PhoneLink.astro';
import MapLink from '../access/MapLink.astro';
import { COMPACT_SERVICE_LABELS, SERVICE_LABELS } from './serviceLabels';

type Props = BusinessCardProps;
const { business, isSponsored = false } = Astro.props;

const confirmedServiceKeys = (Object.keys(SERVICE_LABELS) as ServiceKey[]).filter(
  (key) => business.services[key] === 'confirmed',
);
const addressText = [
  business.location.prefecture,
  business.location.city,
  business.location.addressLine,
]
  .filter(Boolean)
  .join('');
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${business.name} ${addressText}`,
)}`;

const primaryOutbound = business.contact.websiteUrl
  ? {
      href: business.contact.websiteUrl,
      linkType: 'official_site' as const,
      label: '公式サイト',
    }
  : business.contact.directoryUrl
    ? {
        href: business.contact.directoryUrl,
        linkType: 'directory' as const,
        label: '掲載ページ',
      }
    : null;
---

<article
  id={`business-${business.id}`}
  class="business-card"
  data-business-id={business.id}
  data-business-name={business.name}
  data-business-city={business.location.city}
  data-business-order={business.displayOrder}
  data-sponsored={String(isSponsored)}
  data-service-keys={confirmedServiceKeys.join(',')}
>
  <header class="business-card__header">
    <p class="business-card__sponsor-badge" data-sponsor-result-badge hidden>PR｜メインスポンサー</p>
    <h3 class="business-card__name">{business.name}</h3>
    <p class="business-card__meta">
      {business.location.city}
      {
        business.location.nearestGateStatus === 'confirmed' && business.location.nearestGate && (
          <>・{business.location.nearestGate}</>
        )
      }
    </p>
  </header>

  {
    confirmedServiceKeys.length > 0 ? (
      <div class="business-card__services-block">
        <p class="business-card__services-label">対応</p>
        <p class="business-card__services">
          {confirmedServiceKeys.map((key, index) => (
            <>
              {index > 0 && <span class="business-card__separator" aria-hidden="true">／</span>}
              <span class="service-word" data-service-word={key}>
                {COMPACT_SERVICE_LABELS[key]}
              </span>
            </>
          ))}
        </p>
      </div>
    ) : (
      <p class="business-card__services business-card__services--none">対応項目は公開情報では未確認</p>
    )
  }

  <footer class="business-card__actions">
    {
      business.contact.phone && (
        <PhoneLink
          businessId={business.id}
          businessName={business.name}
          phone={business.contact.phone}
        />
      )
    }
    {
      primaryOutbound && (
        <OutboundLink
          businessId={business.id}
          businessName={business.name}
          linkType={primaryOutbound.linkType}
          href={primaryOutbound.href}
          label={primaryOutbound.label}
        />
      )
    }
    <span class="business-card__map-link">
      <MapLink businessId={business.id} businessName={business.name} href={mapHref} />
    </span>
  </footer>
</article>

<style>
  .business-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px double var(--color-stone-line);
    border-radius: var(--radius-card);
    padding: var(--space-5);
  }

  .business-card[hidden] {
    display: none;
  }

  .business-card__header {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
  }

  .business-card__sponsor-badge {
    width: fit-content;
    margin: 0 0 var(--space-1);
    padding: 0.2em 0.65em;
    border: 1px solid var(--color-sponsor-border);
    border-radius: var(--radius-pill);
    background: var(--color-sponsor-bg);
    color: var(--color-sponsor-fg);
    font-size: var(--font-size-caption);
    font-weight: 700;
  }

  .business-card__sponsor-badge[hidden] {
    display: none;
  }

  .business-card__name {
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: var(--font-size-card-title);
    line-height: 1.35;
    color: var(--color-text);
  }

  .business-card__meta {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  .business-card__services-block {
    display: flex;
    align-items: baseline;
    gap: 0.6em;
  }

  .business-card__services-label {
    flex: 0 0 auto;
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-caption);
    font-weight: 700;
  }

  .business-card__services {
    margin: 0;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
    line-height: 1.7;
  }

  .business-card__services--none {
    font-size: var(--font-size-label);
  }

  .business-card__separator {
    margin-inline: 0.22em;
    color: var(--color-stone-line);
  }

  .service-word {
    color: var(--color-stone-text);
  }

  .service-word--matched {
    color: var(--color-accent-deep);
    font-weight: 700;
    background: var(--color-tint-green-bg);
    border-radius: var(--radius-tag, 6px);
    padding: 0.05em 0.3em;
  }

  .service-word--matched::before {
    content: '✓ ';
  }

  .business-card__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-stone-line-soft);
  }

  .business-card__map-link {
    display: inline-flex;
  }

  .business-card__map-link :global(.outbound-link) {
    background: transparent;
    color: var(--color-accent);
    padding-inline: 0.4em;
  }

  @media (max-width: 767px) {
    .business-card {
      gap: 0.65rem;
      padding: 0.9rem 1rem;
    }

    .business-card__name {
      font-size: 1.08rem;
    }

    .business-card__meta,
    .business-card__services {
      font-size: 0.86rem;
    }

    .business-card__services-block {
      display: block;
    }

    .business-card__services-label {
      display: inline;
      margin-right: 0.45em;
    }

    .business-card__services {
      display: inline;
      line-height: 1.65;
    }

    .business-card__actions {
      gap: 0.45rem;
      padding-top: 0.55rem;
    }

    .business-card__actions :global(.outbound-link),
    .business-card__actions :global(.phone-link) {
      min-height: 42px;
      font-size: 0.88rem;
    }
  }
</style>
