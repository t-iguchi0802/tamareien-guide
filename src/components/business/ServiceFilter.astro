---
/**
 * 3分類だけで探す、シンプルな石材店フィルター。
 *
 * 2026-09-21 UI再設計:
 * - 細かなサービス別チェックボックスは使わず、目的は3分類だけにする。
 * - 3分類は複数選択可能。各分類の中では、いずれか1サービスを確認できれば
 *   その分類に対応するとみなし、複数分類を選んだ場合は分類間をANDで絞り込む。
 * - メインスポンサー（sponsoredBusinessIds）は、どの分類を選んでも
 *   検索結果に含め、選択時は最上位PR枠へ表示する。
 * - TOP（mode="link"）と一覧（mode="inline"）で同じ3分類を共有する。
 */
import type { Business, ServiceKey } from '../../types/business';
import { PURPOSE_GROUPS } from './serviceLabels';
import { isFilterableStatus } from '../../lib/data/verificationStatus';
import BusinessGrid from './BusinessGrid.astro';

interface Props {
  businesses: Business[];
  mode: 'inline' | 'link';
  targetPath?: string;
  /** 旧API互換。細かな条件UIは廃止したため現在は使用しない。 */
  openByDefault?: boolean;
  externalGrid?: boolean;
  /** trueの場合、結果件数・クリアUIは呼び出し側で描画する。 */
  externalResult?: boolean;
  /** メインスポンサーと紐づく事業者ID。 */
  sponsoredBusinessIds?: string[];
}

const {
  businesses,
  mode,
  targetPath,
  externalGrid = false,
  externalResult = false,
  sponsoredBusinessIds = [],
} = Astro.props;

const sponsoredBusinessIdSet = new Set(sponsoredBusinessIds);

const businessFilterData = businesses.map((business) => ({
  id: business.id,
  name: business.name,
  displayOrder: business.displayOrder,
  isSponsored: sponsoredBusinessIdSet.has(business.id),
  services: (Object.keys(business.services) as ServiceKey[]).filter((key) =>
    isFilterableStatus(business.services[key]),
  ),
}));
---

<section
  class="service-filter"
  aria-labelledby="service-filter-heading"
  data-filter-mode={mode}
  data-filter-target={targetPath ?? ''}
>
  <div class="service-filter__purpose">
    <h2 id="service-filter-heading" class="service-filter__heading">どんなことでお困りですか？</h2>
    <p class="service-filter__hint">
      複数選択できます。具体的な対応内容は、各石材店の欄で確認できます。
    </p>

    <div class="service-filter__purpose-grid">
      {
        PURPOSE_GROUPS.map((group) => (
          <button
            type="button"
            class="purpose-card"
            data-purpose-button
            data-purpose-id={group.id}
            data-purpose-services={group.serviceKeys.join(',')}
            aria-pressed="false"
          >
            <span class="purpose-card__checkbox" aria-hidden="true">
              <span class="purpose-card__checkbox-check">✓</span>
            </span>
            <span class="purpose-card__copy">
              <span class="purpose-card__heading">{group.heading}</span>
              <span class="purpose-card__description">{group.description}</span>
              <span class="purpose-card__cta" aria-hidden="true">選択する</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  {
    !externalResult && (
      <div class="service-filter__result">
        <p class="service-filter__result-label">石材店一覧</p>
        <p class="service-filter__result-text" aria-live="polite">
          <span data-result-prefix>{mode === 'inline' ? 'すべての事業者' : '掲載中'}</span>
          <strong data-result-count>{businesses.length}</strong>社
        </p>
        <button type="button" class="service-filter__clear" data-filter-clear hidden>
          選択をクリア
        </button>
        {mode === 'link' && targetPath && (
          <a class="service-filter__cta" data-filter-cta href={targetPath}>
            石材店の一覧を見る
          </a>
        )}
      </div>
    )
  }

  <noscript>
    <p class="service-filter__noscript">
      絞り込みにはJavaScriptが必要です。JavaScriptが無効なため、現在は全事業者を表示しています。
    </p>
  </noscript>

  {
    mode === 'inline' && !externalGrid && (
      <BusinessGrid businesses={businesses} sponsoredBusinessIds={sponsoredBusinessIds} />
    )
  }

  <script
    type="application/json"
    data-service-filter-data
    set:html={JSON.stringify(businessFilterData)}
    is:inline
  />

  <script>
    import { trackComparisonFilterUse } from '../../lib/analytics/events';

    interface FilterBusiness {
      id: string;
      name: string;
      displayOrder: number;
      isSponsored: boolean;
      services: string[];
    }

    interface PurposeSelection {
      id: string;
      label: string;
      keys: string[];
    }

    (function initServiceFilter() {
      const root = document.querySelector<HTMLElement>('[data-filter-mode]');
      if (!root) return;

      const dataEl = root.querySelector('[data-service-filter-data]');
      const businessData: FilterBusiness[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
      const purposeButtons = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-purpose-button]'),
      );
      const clearButton = document.querySelector<HTMLButtonElement>('[data-filter-clear]');
      const resultCountEl = document.querySelector('[data-result-count]');
      const resultPrefixEl = document.querySelector('[data-result-prefix]');
      const mode = root.getAttribute('data-filter-mode');
      const targetPath = root.getAttribute('data-filter-target') || '';
      const ctaLink = root.querySelector<HTMLAnchorElement>('[data-filter-cta]');
      const pagePath = window.location.pathname;

      const emptyEl = document.querySelector<HTMLElement>('[data-filter-empty]');
      const grid = document.querySelector<HTMLElement>('[data-business-grid]');
      const showMoreButton = document.querySelector<HTMLButtonElement>('[data-show-more]');
      const showMoreCount = document.querySelector<HTMLElement>('[data-show-more-count]');
      const initialLimit = 10;

      const activePurposeIds = new Set<string>();
      let listExpanded = false;

      function getPurposeSelections(): PurposeSelection[] {
        return purposeButtons
          .filter((button) => activePurposeIds.has(button.dataset.purposeId || ''))
          .map((button) => ({
            id: button.dataset.purposeId || '',
            label:
              button.querySelector<HTMLElement>('.purpose-card__heading')?.textContent?.trim() || '',
            keys: (button.dataset.purposeServices || '').split(',').filter(Boolean),
          }));
      }

      function getActiveKeys(): Set<string> {
        return new Set(getPurposeSelections().flatMap((selection) => selection.keys));
      }

      function syncPurposeButtons(): void {
        purposeButtons.forEach((button) => {
          const id = button.dataset.purposeId || '';
          const selected = activePurposeIds.has(id);
          button.classList.toggle('is-selected', selected);
          button.setAttribute('aria-pressed', String(selected));
        });
        if (clearButton) clearButton.hidden = activePurposeIds.size === 0;
      }

      function track(filterValue: string, resultCount: number): void {
        trackComparisonFilterUse({
          filter_type: 'purpose',
          filter_value: filterValue,
          page_path: pagePath,
          selected_count: activePurposeIds.size,
          result_count: resultCount,
        });
      }

      function applyFilter(): number {
        const selections = getPurposeSelections();
        const activeKeys = getActiveKeys();
        const hasSelection = selections.length > 0;

        const matchingBusinesses = businessData.filter((business) => {
          if (!hasSelection) return true;
          // メインスポンサーは、どの3分類を選んでも検索結果に含める。
          if (business.isSponsored) return true;
          // 各分類内はOR、複数分類間はAND。
          return selections.every((selection) =>
            selection.keys.some((key) => business.services.includes(key)),
          );
        });
        const matchIds = new Set(matchingBusinesses.map((business) => business.id));

        if (resultCountEl) resultCountEl.textContent = String(matchIds.size);
        if (resultPrefixEl) {
          if (!hasSelection) {
            resultPrefixEl.textContent = mode === 'inline' ? 'すべての事業者' : '掲載中';
          } else if (selections.length === 1) {
            resultPrefixEl.textContent = `${selections[0].label}に対応する事業者`;
          } else {
            resultPrefixEl.textContent = '選択した条件に合う事業者';
          }
        }

        if (mode === 'inline' && grid) {
          const cards = Array.from(
            grid.querySelectorAll<HTMLElement>(':scope > [data-business-id]'),
          );

          cards
            .sort((a, b) => {
              if (hasSelection) {
                const sponsorCompare =
                  Number(b.dataset.sponsored === 'true') - Number(a.dataset.sponsored === 'true');
                if (sponsorCompare !== 0) return sponsorCompare;
              }
              return Number(a.dataset.businessOrder || 0) - Number(b.dataset.businessOrder || 0);
            })
            .forEach((card) => grid.appendChild(card));

          let matchedIndex = 0;
          cards.forEach((card) => {
            const id = card.dataset.businessId || '';
            const isMatch = matchIds.has(id);
            const isWithinLimit = listExpanded || matchedIndex < initialLimit;
            card.hidden = !isMatch || !isWithinLimit;
            if (isMatch) matchedIndex += 1;

            const isSponsor = card.dataset.sponsored === 'true';
            const sponsorBadge = card.querySelector<HTMLElement>('[data-sponsor-result-badge]');
            if (sponsorBadge) sponsorBadge.hidden = !(hasSelection && isSponsor);

            const words = Array.from(card.querySelectorAll<HTMLElement>('[data-service-word]'));
            words.forEach((word) => {
              const key = word.dataset.serviceWord || '';
              word.classList.toggle('service-word--matched', hasSelection && activeKeys.has(key));
            });

            const matchBlock = card.querySelector<HTMLElement>('[data-match-block]');
            const matchListEl = card.querySelector<HTMLElement>('[data-match-list]');
            if (matchBlock && matchListEl) {
              const matchedLabels = words
                .filter((word) => activeKeys.has(word.dataset.serviceWord || ''))
                .map((word) => word.textContent?.trim() || '')
                .filter(Boolean);

              if (hasSelection && isMatch && matchedLabels.length > 0) {
                matchListEl.textContent = matchedLabels.join('、');
                matchBlock.hidden = false;
              } else {
                matchListEl.textContent = '';
                matchBlock.hidden = true;
              }
            }
          });

          if (emptyEl) emptyEl.hidden = matchIds.size > 0;
          if (showMoreButton) {
            const remaining = Math.max(0, matchIds.size - initialLimit);
            showMoreButton.hidden = listExpanded || remaining === 0;
            if (showMoreCount) showMoreCount.textContent = String(remaining);
          }
        }

        if (mode === 'link' && ctaLink && targetPath) {
          ctaLink.href = hasSelection
            ? `${targetPath}?purpose=${encodeURIComponent(
                selections.map((selection) => selection.id).join(','),
              )}`
            : targetPath;
        }

        return matchIds.size;
      }

      purposeButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.purposeId || '';
          if (!id) return;
          if (activePurposeIds.has(id)) {
            activePurposeIds.delete(id);
          } else {
            activePurposeIds.add(id);
          }
          syncPurposeButtons();
          listExpanded = false;
          const resultCount = applyFilter();
          track(id, resultCount);
        });
      });

      clearButton?.addEventListener('click', () => {
        activePurposeIds.clear();
        syncPurposeButtons();
        listExpanded = false;
        const resultCount = applyFilter();
        track('clear', resultCount);
      });

      showMoreButton?.addEventListener('click', () => {
        listExpanded = true;
        applyFilter();
      });

      // 新URL: ?purpose=build,closure,care
      const params = new URLSearchParams(window.location.search);
      const fromPurpose = (params.get('purpose') || '').split(',').filter(Boolean);
      fromPurpose.forEach((id) => {
        if (purposeButtons.some((button) => button.dataset.purposeId === id)) {
          activePurposeIds.add(id);
        }
      });

      // 旧URL（?services=...）も、該当する分類へ移行する。
      if (activePurposeIds.size === 0) {
        const oldServices = new Set((params.get('services') || '').split(',').filter(Boolean));
        if (oldServices.size > 0) {
          purposeButtons.forEach((button) => {
            const keys = (button.dataset.purposeServices || '').split(',').filter(Boolean);
            if (keys.some((key) => oldServices.has(key))) {
              const id = button.dataset.purposeId || '';
              if (id) activePurposeIds.add(id);
            }
          });
        }
      }

      syncPurposeButtons();
      applyFilter();
    })();
  </script>
</section>

<style>
  .service-filter {
    display: flex;
    flex-direction: column;
  }

  .service-filter__heading {
    margin: 0 0 var(--space-2);
    font-family: var(--font-family-heading);
  }

  .service-filter__hint {
    margin: 0 0 var(--space-4);
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  .service-filter__purpose-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .purpose-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    min-height: 146px;
    padding: var(--space-4);
    border: 1.5px solid var(--color-stone-line);
    border-radius: var(--radius-card);
    background: #fff;
    color: var(--color-text);
    text-align: left;
    font: inherit;
    cursor: pointer;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      transform 0.15s ease;
  }

  .purpose-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 12px rgba(41, 44, 41, 0.1);
    transform: translateY(-1px);
  }

  .purpose-card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .purpose-card.is-selected {
    border: 2px solid var(--color-accent);
    background: #fff;
  }

  .purpose-card__checkbox {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    margin-top: 0.05em;
    border: 2px solid var(--color-stone-line);
    border-radius: 5px;
    background: #fff;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 800;
    line-height: 1;
  }

  .purpose-card__checkbox-check {
    opacity: 0;
  }

  .purpose-card.is-selected .purpose-card__checkbox {
    border-color: var(--color-accent);
    background: var(--color-accent);
  }

  .purpose-card.is-selected .purpose-card__checkbox-check {
    opacity: 1;
  }

  .purpose-card__copy {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: var(--space-2);
  }

  .purpose-card__heading {
    font-family: var(--font-family-heading);
    font-weight: 700;
    font-size: 1.08rem;
    line-height: 1.4;
  }

  .purpose-card__description {
    flex: 1;
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
    line-height: 1.55;
  }

  .purpose-card__cta {
    margin-top: auto;
    color: var(--color-accent);
    font-size: var(--font-size-caption);
    font-weight: 700;
  }

  .service-filter__result {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-8);
    padding: var(--space-4);
    border: 1px solid var(--color-stone-line);
    border-radius: var(--radius-card);
    background: var(--color-stone-surface);
  }

  .service-filter__result-label {
    width: 100%;
    margin: 0;
    font-family: var(--font-family-heading);
    font-weight: 700;
    color: var(--color-text);
  }

  .service-filter__result-text {
    margin: 0;
    font-size: 1.05rem;
  }

  .service-filter__result-text strong {
    margin-inline: 0.25em;
    font-family: var(--font-family-heading);
    font-size: 1.35rem;
    color: var(--color-accent-deep);
  }

  .service-filter__clear {
    min-height: var(--tap-target-min);
    padding: 0.3em 0.4em;
    border: 0;
    background: transparent;
    color: var(--color-accent);
    text-decoration: underline;
    font: inherit;
    cursor: pointer;
  }

  .service-filter__clear[hidden] {
    display: none;
  }

  .service-filter__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target-min);
    margin-left: auto;
    padding: 0.6em 1.4em;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-surface);
    font-weight: 700;
    text-decoration: none;
  }

  .service-filter__cta:hover {
    background: var(--color-accent-deep);
  }

  .service-filter__noscript {
    color: var(--color-stone-text);
    font-size: var(--font-size-label);
  }

  @media (max-width: 767px) {
    .service-filter__heading {
      margin-bottom: 0.2rem;
      font-size: 1.15rem;
    }

    .service-filter__hint {
      margin-bottom: var(--space-2);
      font-size: 0.82rem;
    }

    .service-filter__purpose-grid {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }

    .purpose-card {
      min-height: 52px;
      padding: 0.65rem 0.8rem;
      align-items: center;
      gap: 0.7rem;
    }

    .purpose-card__checkbox {
      flex-basis: 22px;
      width: 22px;
      height: 22px;
      margin-top: 0;
    }

    .purpose-card__copy {
      gap: 0;
    }

    .purpose-card__heading {
      font-size: 0.96rem;
      line-height: 1.3;
    }

    .purpose-card__description,
    .purpose-card__cta {
      display: none;
    }

    .service-filter__result {
      margin-top: var(--space-6);
      padding: var(--space-3) var(--space-4);
    }

    .service-filter__result-label {
      font-size: 0.95rem;
    }

    .service-filter__result-text {
      width: 100%;
      font-size: 0.92rem;
    }

    .service-filter__result-text strong {
      font-size: 1.2rem;
    }

    .service-filter__cta {
      flex: 1 1 100%;
      margin-left: 0;
    }
  }
</style>
