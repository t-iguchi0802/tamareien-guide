---
/**
 * スポンサー枠2枠一式（左右1枠ずつ）の共通マークアップ。
 *
 * ミチの全体校正・指摘3対応（2026-09-01）: 長い記事ページ（/access/、
 * /guide/history/、/guide/famous-graves/、/guide/procedures/hakajimai-to-kaisou/）で、
 * スマートフォン幅では本文をすべて読み終えたあとに4枠まとめて広告が出る
 * 状態を改善するため、4枠を「前半2枠」「後半2枠」の2組に分けて本文の
 * 途中に挟めるようにした部品。SponsorGroup.astro（4枠一式、TOP・比較ページ等
 * 既存ページで使用中、変更していない）とは別の、記事ページ専用の部品。
 *
 * - class="sponsor-group" を流用しているため、src/layouts/BaseLayout.astroの
 *   既存グローバルCSS（モバイル・タブレット幅で2列グリッド、1400px以上で
 *   display:contentsに切り替える）をそのまま再利用できる。新しいCSSは
 *   BaseLayout.astro側に「1400px以上でこの2枠をどの列へ配置するか」
 *   （data-slot-position属性によるgrid-area指定）だけを追加している。
 * - aria-labelは、SponsorGroup.astro（1ページ1個・aria-label="広告"）と異なり、
 *   1ページに2個並ぶため、axeのlandmark-unique（同名ランドマークの重複）に
 *   抵触しないよう呼び出し側で一意なラベル（例:「広告（記事前半）」）を渡す。
 * - データ取得・並び順の決定ロジックはBaseLayout.astro側に残し、この
 *   コンポーネントは「渡された2枠をそのまま描画する」責務だけを持つ
 *   （SponsorGroup.astroと同じ設計方針）。
 */
import type { Sponsor } from '../../types/sponsor';
import type { SponsorSlotPosition } from '../../types/analytics';
import SponsorSlot from './SponsorSlot.astro';

interface Props {
  left: Sponsor | null;
  right: Sponsor | null;
  leftPosition: Extract<SponsorSlotPosition, 'left-1' | 'left-2'>;
  rightPosition: Extract<SponsorSlotPosition, 'right-1' | 'right-2'>;
  pageCategory: string;
  /** 一意なラベル（axeのlandmark-unique対策。「広告（記事前半）」等）。 */
  label: string;
}

const { left, right, leftPosition, rightPosition, pageCategory, label } = Astro.props;
---

<aside class="sponsor-group sponsor-pair" data-sponsor-root aria-label={label}>
  <SponsorSlot sponsor={left} position={leftPosition} pageCategory={pageCategory} />
  <SponsorSlot sponsor={right} position={rightPosition} pageCategory={pageCategory} />
</aside>
