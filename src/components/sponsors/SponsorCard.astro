---
/**
 * スポンサー枠（広告）カード。
 *
 * デザイン方針（frontend-design検討、2026-08-26）:
 * - 通常のBusinessCard（見出しは明朝体＝「刻字」を思わせる編集書体）とは
 *   意図的に書体を分け、スポンサー名はゴシック体（本文と同じ）で組む。
 *   色だけでなく書体でも「これは編集記事ではなく広告である」ことを示す。
 * - 既存の「石の目地」二重線モチーフを金色（--color-sponsor-border）で
 *   カード上部に再利用し、サイト全体の視覚的ファミリーは保ちながら
 *   色で系統を分ける（コピー用の破線枠のような、いかにも「広告然」とした
 *   表現は避けた）。
 * - 「広告・スポンサー」の表記は、塗りつぶしバッジではなく静かな
 *   スモールキャップス風のレーベルとして、名前の上に置く。
 * - 料金・契約条件はここには一切表示しない（トップページに大きく
 *   出さないという要件、および実データに料金フィールドを持たせていない）。
 *
 * 計測: 外部リンクに `data-event="sponsor_click"` を付与し、既存の
 * `initAnalyticsDispatcher`（BaseLayout経由）でクリックを計測する。
 * 表示回数（sponsor_impression）はクリックではないためディスパッチャの
 * 対象外とし、親のSponsorSection.astro側でIntersectionObserverから
 * `trackSponsorImpression()` を直接呼び出す（このカード自身は`data-sponsor-id`
 * `data-campaign-id` を持つルート要素を提供するだけで、表示検知ロジックは持たない）。
 *
 * 有料リンクにはGoogle/検索エンジン向けに `rel="sponsored"` を付与する
 * （`noopener noreferrer` と併記）。
 */
import '../../styles/tokens.css';
import type { SponsorCardProps } from '../../types/components';

type Props = SponsorCardProps;
const { sponsor } = Astro.props;
---

<aside class="sponsor-card" data-sponsor-id={sponsor.id} data-campaign-id={sponsor.campaignId}>
  <p class="sponsor-card__eyebrow">広告・スポンサー</p>
  <hr class="sponsor-card__rule" />
  <div class="sponsor-card__body">
    {
      sponsor.logoUrl && (
        <img class="sponsor-card__logo" src={sponsor.logoUrl} alt="" loading="lazy" width="40" height="40" />
      )
    }
    <div class="sponsor-card__text">
      <p class="sponsor-card__name">{sponsor.name}</p>
      <p class="sponsor-card__summary">{sponsor.summary}</p>
    </div>
  </div>
  <a
    class="sponsor-card__link"
    href={sponsor.websiteUrl}
    target="_blank"
    rel="noopener noreferrer sponsored"
    data-event="sponsor_click"
    data-sponsor-id={sponsor.id}
    data-campaign-id={sponsor.campaignId}
  >
    サイトを見る
    <span class="sr-only">（外部サイトを新しいタブで開きます）</span>
  </a>
  <p class="sponsor-card__disclosure">掲載順・比較結果には影響しません。</p>
</aside>

<style>
  .sponsor-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    background: var(--color-sponsor-bg);
    border: 1px solid var(--color-sponsor-border);
    border-radius: var(--radius-card);
    padding: var(--space-4);
    height: 100%;
  }

  .sponsor-card__eyebrow {
    margin: 0;
    font-family: var(--font-family-base);
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-sponsor-fg);
  }

  .sponsor-card__rule {
    border: none;
    border-top: 3px double var(--color-sponsor-border);
    margin: 0;
  }

  .sponsor-card__body {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    flex: 1;
  }

  .sponsor-card__logo {
    flex: none;
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
    background: var(--color-surface);
  }

  .sponsor-card__text {
    display: flex;
    flex-direction: column;
    gap: 0.35em;
  }

  .sponsor-card__name {
    margin: 0;
    font-family: var(--font-family-base);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .sponsor-card__summary {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-label);
    line-height: 1.6;
  }

  .sponsor-card__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    padding: 0.5em 1.1em;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1.5px solid var(--color-sponsor-border);
    color: var(--color-sponsor-fg);
    font-weight: 700;
    font-size: var(--font-size-label);
    text-decoration: none;
  }

  .sponsor-card__link:hover {
    background: var(--color-sponsor-border);
    color: var(--color-surface);
  }

  .sponsor-card__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .sponsor-card__disclosure {
    margin: 0;
    font-size: var(--font-size-caption);
    color: var(--color-stone-text);
  }
</style>
