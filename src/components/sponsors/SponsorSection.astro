---
/**
 * TOPページ用スポンサー枠セクション。
 *
 * - 通常掲載（BusinessCard/ServiceFilter）とは完全に分離する。
 *   絞り込み条件・検索結果件数を一切参照せず、常に同じ内容を表示する
 *   （data_dictionary.md 9章「スポンサー契約の有無を…比較結果、評価に
 *   反映しない」に対応。ここでは逆方向＝比較結果側の状態がスポンサー表示に
 *   影響することも避ける）。
 * - 有効なスポンサーが1〜4件のときは、同じ大きさ・同じ優先度のカードを
 *   `displayOrder`順に並べる（並び替え・強調表示なし）。
 * - 有効なスポンサーが0件のときは、4枠の空白ではなく
 *   「地域スポンサー募集中」の案内を1つだけ表示する。料金・契約条件は
 *   ここに書かない（siteConfigやSponsor型にも料金フィールドを持たせていない）。
 * - 表示回数（sponsor_impression）はIntersectionObserverで検知し、
 *   1スポンサーにつきそのページ滞在中1回だけ送信する。クリック
 *   （sponsor_click）は SponsorCard.astro 内の data-event 経由で
 *   既存ディスパッチャに接続済み。募集中カードは実際の広告枠ではないため
 *   計測イベントを送らない。
 */
import type { Sponsor } from '../../types/sponsor';
import SponsorCard from './SponsorCard.astro';
import { ROUTES } from '../../lib/routes';

interface Props {
  sponsors: Sponsor[];
}

const { sponsors } = Astro.props;
---

<section class="sponsor-section" aria-labelledby="sponsor-section-heading">
  <h2 id="sponsor-section-heading" class="sponsor-section__heading">スポンサー</h2>
  {
    sponsors.length > 0 ? (
      <div class="sponsor-section__grid" data-sponsor-grid>
        {sponsors.map((sponsor) => (
          <SponsorCard sponsor={sponsor} />
        ))}
      </div>
    ) : (
      <div class="sponsor-recruit">
        <p class="sponsor-recruit__eyebrow">広告・スポンサー</p>
        <hr class="sponsor-recruit__rule" />
        <p class="sponsor-recruit__heading">地域スポンサー募集中</p>
        <p class="sponsor-recruit__body">
          多磨霊園周辺で事業を営む方の掲載をご検討の場合は、運営方針ページの窓口からお問い合わせください。
        </p>
        <a class="sponsor-recruit__link" href={ROUTES.about.path}>掲載について問い合わせる</a>
      </div>
    )
  }

  {
    sponsors.length > 0 && (
      <script>
        import { trackSponsorImpression } from '../../lib/analytics/events';

        (function initSponsorImpressions() {
          const grid = document.querySelector<HTMLElement>('[data-sponsor-grid]');
          if (!grid) return;
          if (typeof IntersectionObserver === 'undefined') return;

          const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-sponsor-id]'));
          if (cards.length === 0) return;

          const pagePath = window.location.pathname;
          const seen = new Set<string>();

          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                const sponsorId = el.getAttribute('data-sponsor-id');
                const campaignId = el.getAttribute('data-campaign-id');
                if (!sponsorId || !campaignId || seen.has(sponsorId)) return;
                seen.add(sponsorId);
                trackSponsorImpression({
                  sponsor_id: sponsorId,
                  campaign_id: campaignId,
                  page_path: pagePath,
                });
                observer.unobserve(el);
              });
            },
            { threshold: 0.5 },
          );

          cards.forEach((card) => observer.observe(card));
        })();
      </script>
    )
  }
</section>

<style>
  .sponsor-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .sponsor-section__heading {
    font-family: var(--font-family-heading);
    margin: 0;
  }

  .sponsor-section__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 260px));
    justify-content: start;
    gap: var(--space-4);
  }

  .sponsor-section__grid > :global(*) {
    /* 1〜4件のどの件数でも、カードの大きさ・優先度が揃って見えるようにする
       （grid-template-columnsの上限とjustify-content: startにより、
       1件だけの場合でも横幅いっぱいに間延びしない）。 */
    max-width: 260px;
  }

  .sponsor-recruit {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 420px;
    background: var(--color-sponsor-bg);
    border: 1px solid var(--color-sponsor-border);
    border-radius: var(--radius-card);
    padding: var(--space-4);
  }

  .sponsor-recruit__eyebrow {
    margin: 0;
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-sponsor-fg);
  }

  .sponsor-recruit__rule {
    border: none;
    border-top: 3px double var(--color-sponsor-border);
    margin: 0;
  }

  .sponsor-recruit__heading {
    margin: 0;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--color-text);
  }

  .sponsor-recruit__body {
    margin: 0;
    color: var(--color-text);
    font-size: var(--font-size-label);
    line-height: 1.6;
  }

  .sponsor-recruit__link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target-min);
    padding: 0.5em 1.1em;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1.5px solid var(--color-sponsor-border);
    color: var(--color-sponsor-fg);
    font-weight: 700;
    font-size: var(--font-size-label);
    text-decoration: none;
  }

  .sponsor-recruit__link:hover {
    background: var(--color-sponsor-border);
    color: var(--color-surface);
  }

  .sponsor-recruit__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>
