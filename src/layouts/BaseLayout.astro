       縦に並ぶよう2行にまたがせる。PC幅でのスポンサーの視覚位置は、
       「本文の左右」という意味では通常の.page-shellと同じである。 --- */
    .page-shell--split {
      grid-template-areas: 'rail-left before rail-right' 'rail-left rest rail-right';
      row-gap: var(--space-6);
    }

    .page-shell--split .site-main--before {
      grid-area: before;
    }

    .page-shell--split .site-main--rest {
      grid-area: rest;
    }

    .sponsor-group {
      display: contents;
    }

    .sponsor-rail {
      display: flex;
      flex-direction: column;
      gap: 22px;
      align-self: start;
    }

    /* 画面の高さが十分あるときだけstickyにする（2枠分の高さ
       （320px×2＋列間22px≒662px）が収まらない低い画面ではstickyにしない）。 */
    @media (min-height: 700px) {
      .sponsor-rail {
        position: sticky;
        top: var(--space-4);
      }
    }

    .sponsor-rail--left {
      grid-area: rail-left;
    }

    .sponsor-rail--right {
      grid-area: rail-right;
    }

    /* スポンサー枠本体のPCサイズ（高さのみ上書き。幅はレール＝グリッド列の
