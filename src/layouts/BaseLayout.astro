    <script>
      // ヘッダー「多磨霊園を知る」ドロップダウンの開閉制御（2026-09-02、
      // ナビゲーション監査対応「ヘッダーを増やしすぎない」節）。
      // hoverには依存せず、クリック・Enter/Space（<button>のネイティブ挙動）・
      // Escape・メニュー外クリックで開閉する。1ページに複数のドロップダウンが
      // あってもよいよう、data-nav-dropdown単位で独立して動く。
      (function initNavDropdowns() {
        const dropdowns = Array.from(document.querySelectorAll<HTMLElement>('[data-nav-dropdown]'));
        if (dropdowns.length === 0) return;

        function closeDropdown(dropdown: HTMLElement): void {
          dropdown.removeAttribute('data-open');
          const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-trigger]');
          if (trigger) trigger.setAttribute('aria-expanded', 'false');
        }

        function openDropdown(dropdown: HTMLElement): void {
          dropdowns.forEach((other) => {
            if (other !== dropdown) closeDropdown(other);
          });
          dropdown.setAttribute('data-open', '');
          const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-trigger]');
          if (trigger) trigger.setAttribute('aria-expanded', 'true');
        }

        dropdowns.forEach((dropdown) => {
          const trigger = dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-trigger]');
          if (!trigger) return;

          trigger.addEventListener('click', () => {
            const isOpen = dropdown.hasAttribute('data-open');
            if (isOpen) {
              closeDropdown(dropdown);
            } else {
              openDropdown(dropdown);
            }
          });
        });

        // メニュー外クリックで閉じる。
        document.addEventListener('click', (evt) => {
          dropdowns.forEach((dropdown) => {
            if (!dropdown.hasAttribute('data-open')) return;
            if (evt.target instanceof Node && !dropdown.contains(evt.target)) {
              closeDropdown(dropdown);
            }
          });
        });

        // Escapeで閉じ、トリガーへフォーカスを戻す。
        document.addEventListener('keydown', (evt) => {
          if (evt.key !== 'Escape') return;
          dropdowns.forEach((dropdown) => {
            if (!dropdown.hasAttribute('data-open')) return;
            closeDropdown(dropdown);
            dropdown.querySelector<HTMLButtonElement>('[data-nav-dropdown-trigger]')?.focus();
          });
        });
      })();
    </script>

    <script>
      // スポンサー枠の表示回数計測（全ページ共通、2026-08-28に
      // src/pages/index.astroから移設）。IntersectionObserverで
      // 実際にビューポート内に入った枠だけを、1枠につき1回計測する。
      // querySelectorAll（複数形）にしているのは、`[data-sponsor-root]`が
      // 将来複数になっても計測漏れが起きないようにするための保険
      // （2026-09-01時点では1ページにつき常に1個＝SponsorGroup 1回のみ）。
      import { trackSponsorImpression } from '../lib/analytics/events';
      import type { SponsorSlotPosition } from '../types/analytics';

      (function initSponsorImpressions() {
        const roots = Array.from(document.querySelectorAll<HTMLElement>('[data-sponsor-root]'));
        if (roots.length === 0) return;
        if (typeof IntersectionObserver === 'undefined') return;

        const slots = roots.flatMap((root) => Array.from(root.querySelectorAll<HTMLElement>('[data-sponsor-id]')));
        if (slots.length === 0) return;

        const pagePath = window.location.pathname;
        const seen = new Set<string>();

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              const sponsorId = el.getAttribute('data-sponsor-id');
              const sponsorName = el.getAttribute('data-sponsor-name');
              const campaignId = el.getAttribute('data-campaign-id');
              const slotPosition = el.getAttribute('data-slot-position') as SponsorSlotPosition | null;
              const pageCategory = el.getAttribute('data-page-category');
              if (!sponsorId || !sponsorName || !campaignId || !slotPosition || !pageCategory || seen.has(sponsorId)) return;
              seen.add(sponsorId);
              trackSponsorImpression({
                sponsor_id: sponsorId,
                sponsor_name: sponsorName,
                campaign_id: campaignId,
                page_path: pagePath,
                slot_position: slotPosition,
                page_category: pageCategory,
              });
              observer.unobserve(el);
            });
          },
          { threshold: 0.5 },
        );

        slots.forEach((slot) => observer.observe(slot));
      })();
    </script>
  </body>
</html>

