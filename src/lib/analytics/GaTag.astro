---
/**
 * GA4（gtag.js）読み込みコンポーネント。
 *
 * 2026-10-02 性能改善:
 * - dataLayer / gtag関数とconfig呼び出しは即時に用意し、ページビューや
 *   早い操作イベントをキューできる状態を維持する。
 * - 約500KBの外部gtag.js本体はwindow load後に非同期で読み込む。
 *   これによりファーストビュー描画と競合する初期のJavaScript実行を避ける。
 * - gtag.js読み込み前のイベントはdataLayerへ積まれ、読み込み後に処理される。
 */
import { getGaMeasurementId } from './config';

const measurementId = getGaMeasurementId();

if (!measurementId) {
  return;
}
---

<script is:inline define:vars={{ measurementId }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    // Google tagの公式キュー形式に合わせてArgumentsを積む。
    window.dataLayer.push(arguments);
  }
  window.gtag = gtag;
  gtag('js', new Date());
  gtag('config', measurementId, { send_page_view: true });

  (function deferGoogleTag() {
    let loaded = false;

    function loadTag() {
      if (loaded) return;
      loaded = true;
      const script = document.createElement('script');
      script.async = true;
      script.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(measurementId);
      document.head.appendChild(script);
    }

    function schedule() {
      if ('requestIdleCallback' in window) {
        window.requestIdleCallback(loadTag, { timeout: 1000 });
      } else {
        window.setTimeout(loadTag, 0);
      }
    }

    if (document.readyState === 'complete') {
      schedule();
    } else {
      window.addEventListener('load', schedule, { once: true });
    }
  })();
</script>
